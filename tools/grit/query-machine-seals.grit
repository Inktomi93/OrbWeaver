// Plugin: query-machine-seals (client-architecture-lockdown.md §14/§16 G9) — the two query-machine
// hard seals. Every mutation rides `createEntityMutation` (the ONE mutation home, with its
// invalidation/bus-driven belt) — a raw `useMutation` import is the bypass. `createCollectionSurface`
// is the sole paginated-browse factory — a raw `useInfiniteQuery` import hand-rolls pagination it
// already owns. Verified clean today (16/16 mutation hooks on the factory; useInfiniteQuery only in
// the factory) — a hard seal, no ratchet.
language js

or {
  `import { $imports } from "@tanstack/react-query"` where {
    $imports <: contains `useMutation`,
    $filename <: not or {
      r".*/packages/client/src/data/.*",
      r".*\.test\.tsx?$"
    },
    register_diagnostic(span=$imports, message="useMutation imported from @tanstack/react-query outside data/ — every mutation rides createEntityMutation (the ONE mutation home, with its invalidation/bus-driven belt); a raw useMutation call site skips it. See client-architecture-lockdown.md §14/§16 G9.")
  },
  `import { $imports } from "@tanstack/react-query"` where {
    $imports <: contains `useInfiniteQuery`,
    $filename <: not or {
      r".*/packages/client/src/data/create-collection-surface\.ts$",
      r".*\.test\.tsx?$"
    },
    register_diagnostic(span=$imports, message="useInfiniteQuery imported from @tanstack/react-query outside data/create-collection-surface.ts — createCollectionSurface is the sole paginated-browse factory; a raw call hand-rolls pagination it already owns. See client-architecture-lockdown.md §14/§16 G9.")
  }
}
