// Plugin: zustand-selector-stability — a zustand selector returning a FRESH object/array literal
// per render spins `useSyncExternalStore` forever under v5's `Object.is` equality (v5 REMOVED v4's
// implicit shallow compare, so this class got MORE dangerous — UI-Lib-Zustand.md B-2; runtime-only,
// no compile signal, which is why it's a gate). Fix: select a stored reference, return a frozen
// module constant for the default branch (`?? EMPTY`), or wrap multi-field selectors in
// `useShallow`.
language js

or {
  `$store(($s) => ({ $... }))`,
  `$store(($s) => [$...])`
} as $node where {
  $store <: r"^use[A-Z].*Store$",
  $filename <: not r".*\.test\.tsx?$",
  register_diagnostic(span=$node, message="zustand selector returns a fresh object/array literal — under v5's Object.is this re-renders forever (useSyncExternalStore loop). Select a stored ref, use a frozen module-constant default, or wrap in useShallow. See UI-Lib-Zustand.md C-1/B-2.")
}
