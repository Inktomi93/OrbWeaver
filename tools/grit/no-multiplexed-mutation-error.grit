// Plugin: no-multiplexed-mutation-error — TanStack Query v5 mutation errors are STICKY (they
// persist until the next mutate/reset), so `a.error ?? b.error` / `a.error || b.error` fed into one
// surface leaks action A's stale failure into B's UI (UI-Gates §11.1 — a documented neo prod bug).
// One error slot per mutation: render each mutation's own `.error`, or use createEntityMutation's
// per-mutation `{ error, clearError }` channel.
language js

or {
  `$a.error ?? $b.error`,
  `$a.error || $b.error`
} as $node where {
  $filename <: r".*/packages/client/src/.*",
  $filename <: not r".*\.test\.tsx?$",
  register_diagnostic(span=$node, message="multiplexed mutation errors — v5 errors are sticky until the next mutate, so this leaks one action's stale failure into another's surface. One error slot per mutation (createEntityMutation's { error, clearError }). See UI-Gates-and-Lessons.md §11.1.")
}
