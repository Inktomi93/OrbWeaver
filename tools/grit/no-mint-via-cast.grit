// Plugin: no-mint-via-cast — `castId(<generator call>)` mints a NEW id by laundering a freshly
// generated value (crypto.randomUUID() / nanoid() / createId() / uuidv4()) through the RE-BRAND helper.
// `castId` RE-BRANDS a value that already IS an id (a DB row read, a cursor) — it must NEVER mint.
// Mint with `mintTypeId(ID_PREFIX.x)` (TypeID) or `newId<T>()` (nanoid) from `@orb/kit/ids` so the
// value matches its `typeIdSchema` at the wire (a raw UUID is rejected by the prefix check).
// PRODUCTION only (tests/tooling/scripts skipped). Template-literal placeholders are NOT matched.
// Refs: Spine-TypeScript-and-Patterns.md, the no-loose-id-cast + no-raw-id companions.
language js

or {
  `castId($arg)`,
  `castId<$_t>($arg)`
} as $cast where {
  $filename <: not or { r".*\.test\.tsx?$", r".*\.spec\.tsx?$", r".*/tests/.*", r".*/tools/.*", r".*/scripts/.*" },
  $arg <: or {
    `crypto.randomUUID()`,
    `randomUUID()`,
    `nanoid()`,
    `nanoid($_n)`,
    `createId()`,
    `createId($_a)`,
    `uuidv4()`,
    `uuidV4()`,
    `uuid()`
  },
  register_diagnostic(span=$cast, message="castId(<generator>) MINTS an id by laundering a fresh value through the RE-BRAND helper — castId is for re-branding a value that already IS an id, NEVER for minting. Mint with mintTypeId(ID_PREFIX.x) (TypeID) or newId<T>() (nanoid) from @orb/kit/ids so the value matches typeIdSchema at the wire. See Spine-TypeScript-and-Patterns.md.", severity="error")
}
