// Plugin: no-untrusted-html-in-main-dom
// Severity: error
// ──────────────────────────────────────────────────────────────────────────────
// Catches:    `dangerouslySetInnerHTML=` on any JSX element in packages/{client,ui}/src.
//
// Rationale:  D44 §12.2 — untrusted/rich HTML never touches the app document DOM. It
//             goes through <SandboxFrame> (a sandboxed iframe + per-frame CSP) for
//             untrusted cards, or the sanitized @orb/ui/markdown seal (Streamdown +
//             the Tier-A allowlist). A raw dangerouslySetInnerHTML is an XSS door.
//
// Scope:      packages/{client,ui}/src, EXCEPT the two seals that own the sanctioned
//             paths (markdown/ sanitizes; sandbox-frame/ isolates via iframe srcDoc).
//
// Refs:       docs/architecture/core/UI-Gates-and-Lessons.md §12.6 (D44 gates)
//             packages/ui/src/content/sandbox-frame/ · packages/ui/src/markdown/
// ──────────────────────────────────────────────────────────────────────────────

language js

JsxAttribute() as $attr where {
  $filename <: r".*/packages/(?:client|ui)/src/.*",
  $filename <: not or {
    r".*/packages/ui/src/markdown/.*",
    r".*/packages/ui/src/content/sandbox-frame/.*"
  },
  $attr <: r"^dangerouslySetInnerHTML(?:=.*)?$",
  register_diagnostic(span=$attr, message="dangerouslySetInnerHTML in the app DOM — untrusted HTML MUST go through <SandboxFrame> (sandboxed iframe + per-frame CSP) or the sanitized @orb/ui/markdown seal (D44 §12.2). Never inject raw HTML into the main document.", severity="error")
}
