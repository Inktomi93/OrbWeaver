// Plugin: no-raw-random — ambient `Math.random()` in shipped source breaks determinism the same
// way an ambient clock does (client-determinism, UI-Gates §11.5: no Math.random in render/
// optimistic code — a seeded PRNG is fine; server determinism rides the injected id/clock seams).
// Legal homes: tests' seeded helpers (tests/ are exempt via their own support seams), scripts/,
// and @orb/kit's seeded-prng/id modules (the injection seams themselves).
language js

`Math.random()` as $node where {
  $filename <: not or {
    // The composition roots are the sanctioned PROD-entropy injection sites (the injected-PRNG
    // seam's real source lives where everything else is wired — entry/ and the client main.tsx).
    r".*/packages/server/src/entry/.*",
    r".*/packages/client/src/main\.tsx$",
    r".*/tests/.*",
    r".*/scripts/.*",
    r".*/tools/.*",
    r".*/packages/kit/src/(ids|prng|random)/.*",
    r".*\.test\.tsx?$"
  },
  register_diagnostic(span=$node, message="ambient Math.random() — determinism: inject a seeded PRNG / the seeded id generator instead (the same seam tests pin). See UI-Gates-and-Lessons.md §11.5 / Spine-Testing.md §3.")
}
