// Plugin: no-inline-types — an EXPORTED `type` / `interface` / `z.object` / `z.enum` /
// `z.discriminatedUnion` declared OUTSIDE a type home. Feature types live in the feature's `contract/`
// (or `@orb/contracts`); the canonical type homes are `**/contract/**`, `packages/{kit,contracts,db}`,
// and `**/server/src/kit/**`. Anywhere else (a verb, a service, a component) an exported type is a
// boundary leak — move it to the contract and import it. §7.4 (types-in-contract / no-inline-types).
// Skips tests. Non-exported, file-local type aliases are fine (not matched — only `export`ed ones).
// Refs: spine/types-and-schemas.md §7.4.
language js

or {
  `export type $name = $_` as $node,
  `export const $name = z.object($_)` as $node,
  `export const $name = z.enum($_)` as $node,
  `export const $name = z.discriminatedUnion($_)` as $node
} where {
  $filename <: not or {
    r".*/contract/.*",
    r".*/packages/(?:kit|contracts|db)/.*",
    r".*/server/src/kit/.*",
    r".*\.test\.tsx?$",
    r".*/tests/.*",
    r".*/scripts/.*",
    r".*/tools/.*"
  },
  register_diagnostic(span=$node, message="exported type/interface/zod-schema outside a type home — feature types live in the feature's contract/ (or @orb/contracts), not in a verb/service/component. Move it to contract/ and import it. See spine/types-and-schemas.md §7.4.")
}
