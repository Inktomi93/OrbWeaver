// Plugin: theme-override-only-via-scope
// Severity: error
// ──────────────────────────────────────────────────────────────────────────────
// Catches:    An inline `style={{ ... }}` that sets a `--color-*` design-token CSS
//             variable, in packages/{client,ui}/src.
//
// Rationale:  D44 §12.1 — per-message/per-entity theming overrides tokens ONLY through
//             <ThemeScope>, which CLAMPS every value at the boundary (parse-as-color,
//             reject url()/expression()/@import, cap length). A raw
//             style={{ "--color-primary": userValue }} smuggles an unclamped value
//             straight into the cascade — the exact CSS-injection vector the clamp exists
//             to close.
//
// Scope:      packages/{client,ui}/src, EXCEPT the two components that legitimately emit
//             token vars (theme-scope/ IS the clamp; sandbox-frame/ clamps themeTokens
//             into an isolated frame).
//
// Refs:       docs/architecture/core/UI-Gates-and-Lessons.md §12.6 (D44 gates)
//             packages/ui/src/content/theme-scope/ (the clamp)
// ──────────────────────────────────────────────────────────────────────────────

language js

JsxAttribute() as $attr where {
  $filename <: r".*/packages/(?:client|ui)/src/.*",
  $filename <: not or {
    r".*/packages/ui/src/content/theme-scope/.*",
    r".*/packages/ui/src/content/sandbox-frame/.*"
  },
  $attr <: r"^style=.*--color-.*$",
  register_diagnostic(span=$attr, message="inline style overriding a --color-* design token — token overrides go through <ThemeScope> (values clamped at the boundary: parse-as-color, reject url()/expression()/@import; D44 §12.1). Never set --color-* in a raw style prop.", severity="error")
}
