// Plugin: no-if-is-group — an `isGroup` / `isGroupChat` / `isGroupMode` / `is_group` IDENTITY boolean
// (binding OR reference: `const isGroup = …`, `if (isGroup)`, `isGroup ? a : b`). The design forbids the
// `if(isGroup)` fork: solo is the DEGENERATE case of group — a roster-of-one — so every group affordance
// must NO-OP at roster=1 to keep a one-character turn byte-identical. Gate on roster/cast SIZE
// (`speakers.length > 1`) which degrades cleanly, NOT on a group-vs-solo identity boolean.
// NOT caught: size gates (`multiSpeaker`, `length > 1`). PRODUCTION only (tests/tooling/scripts skipped).
// Refs: domains/chat.md (unified group chat — solo = degenerate group), participants-agents-identity.md.
language js

or {
  `const $name = $_` as $decl where {
    $filename <: not or { r".*\.test\.tsx?$", r".*\.spec\.tsx?$", r".*/tests/.*", r".*/tools/.*", r".*/scripts/.*" },
    $name <: r"^(?:isGroup|isGroupChat|isGroupMode|is_group)$",
    register_diagnostic(span=$decl, message="`isGroup`-style boolean branches on group-vs-solo identity — the design forbids it (solo is the degenerate case of group). Gate on explicit roster/cast size that NO-OPS at roster=1 (so byte-identity holds). See domains/chat.md (unified group chat).", severity="error")
  },
  `let $name = $_` as $decl where {
    $filename <: not or { r".*\.test\.tsx?$", r".*\.spec\.tsx?$", r".*/tests/.*", r".*/tools/.*", r".*/scripts/.*" },
    $name <: r"^(?:isGroup|isGroupChat|isGroupMode|is_group)$",
    register_diagnostic(span=$decl, message="`isGroup`-style boolean branches on group-vs-solo identity — the design forbids it (solo is the degenerate case of group). Gate on explicit roster/cast size that NO-OPS at roster=1 (so byte-identity holds). See domains/chat.md (unified group chat).", severity="error")
  },
  `if ($name) $_` as $ref where {
    $filename <: not or { r".*\.test\.tsx?$", r".*\.spec\.tsx?$", r".*/tests/.*", r".*/tools/.*", r".*/scripts/.*" },
    $name <: r"^(?:isGroup|isGroupChat|isGroupMode|is_group)$",
    register_diagnostic(span=$ref, message="`isGroup`-style boolean branches on group-vs-solo identity — the design forbids it. Gate on roster/cast size that NO-OPS at roster=1. See domains/chat.md.", severity="error")
  },
  `$name ? $_ : $_` as $ref where {
    $filename <: not or { r".*\.test\.tsx?$", r".*\.spec\.tsx?$", r".*/tests/.*", r".*/tools/.*", r".*/scripts/.*" },
    $name <: r"^(?:isGroup|isGroupChat|isGroupMode|is_group)$",
    register_diagnostic(span=$ref, message="`isGroup`-style boolean branches on group-vs-solo identity — the design forbids it. Gate on roster/cast size that NO-OPS at roster=1. See domains/chat.md.", severity="error")
  }
}
