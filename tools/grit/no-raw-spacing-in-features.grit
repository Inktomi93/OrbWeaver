// Plugin: no-raw-spacing-in-features
// Severity: warn
// ──────────────────────────────────────────────────────────────────────────────
// Catches:    Raw Tailwind spacing utilities in className strings — `gap-3`,
//             `py-2`, `px-4`, `mt-6`, `space-y-3`, `m-[12px]`, etc. — inside:
//               • JSX `className="..."` attributes
//               • `cn(...)` / `clsx(...)` / `cva(...)` call args (any nesting)
//
// Rationale:  Structural layout uses layout primitives + intent tokens, not raw
//             scale classes. The intent tokens map to design decisions ("a row
//             of fields"), the scale numbers map to nothing.
//
//               ❌ <div className="flex flex-col gap-3 py-2">
//               ✅ <Stack gap="row" padding="row">
//               ✅ <div className="flex flex-col gap-row py-row">  (intent OK)
//               ✅ <PopoverContent className="p-0">  (bare `-0` is an explicit
//                  RESET, not a magic scale number — and has no intent token, so
//                  it's allowed. `-0.5`/`-3`/`-[12px]` still fire.)
//
//             Intent tokens (defined in theme.css):
//               gap-field · gap-row · gap-block · gap-section · gap-gutter
//               p[xy]-row · p[xy]-block · p[xy]-section · p[xy]-gutter
//
//             Layout primitives (packages/ui/src/layout/):
//               <Stack> · <Row> · <Section> · <Toolbar>
//
// Scope:      Fires ONLY inside the substrate-gated client paths
//             (packages/{client,ui}/src) and SKIPS the allowlist —
//             via the in-rule `$filename` guard below, NOT per-line suppressions.
//             (There is no `scripts/check/substrate-clean.ts` in orb — that name is a
//             Deferred-Dropped backlog item, Core-Enforcement-Deferred-Dropped.md; this
//             grit IS the substrate-cleanliness ratchet, self-contained.)
//             Allowlisted (own raw scale by design):
//               • packages/ui/src/layout/   — primitives DEFINE the tokens
//               • packages/ui/src/markdown/ — prose chrome (streamdown rendering)
//             (no components/ui/ or features/_shared/ drawer exists in orb — D43 §11.0:
//             no directory is exempt from a boundary rule; the two paths above are the
//             token-DEFINING seal, not a convenience exemption.)
//             ($filename guards are biome-2.4-native — see no-await-db-in-loop.grit;
//             the old github.com/biomejs/biome/issues/6851 note was about `overrides`,
//             which can't disable a plugin per-path. The grit pattern itself can.)
//             Default-param values like `bodyClassName = "space-y-3"` still aren't
//             matched (would need an object-destructure-default arm — see spike RESULTS).
//
// Refs:       docs/architecture/core/UI-Architecture-and-Layout.md
//             packages/ui/src/layout/ (primitives)
//             packages/ui/src/styles/theme.css (intent token definitions)
// ──────────────────────────────────────────────────────────────────────────────
//
// GritQL note: identical shape to no-raw-z-index and no-color-literals — the
// className-string trio. JsxAttribute() for the attribute case; cn/clsx/cva
// arms with `contains bubble` descend into function call args. `bubble` makes
// each inner `$lit` match independent so multiple bad utilities in one call
// each fire. `in_substrate_scope()` is the shared path guard (DRY across arms).
//
// Perf note: cumulative time dropped ~40× by scoping to JsxAttribute() instead
// of every string literal — see spikes/biome-perf/RESULTS.md.

language js

// Shared guard: the file is a substrate-gated client path AND not allowlisted.
// Self-contained (no scripts/check/substrate-clean.ts in orb — Deferred-Dropped backlog
// item; this predicate IS the ratchet). $filename is auto-bound by biome.
predicate in_substrate_scope() {
  // D43 §11.4: the token gates cover ALL feature + ui TSX (no components/ui-style exemption).
  // @orb/ui is in scope; its layout/ primitives are allowlisted below (they DEFINE the tokens).
  $filename <: r".*/packages/(?:client|ui)/src/.*",
  $filename <: not or {
    r".*/packages/ui/src/layout/.*",
    r".*/packages/ui/src/markdown/.*"
  }
}

or {
  JsxAttribute() as $attr where {
    in_substrate_scope(),
    $attr <: r"^className=\"[^\"]*\b(?:gap|p[xytrbl]?|m[xytrbl]?|space-[xy])-(?:[1-9]\d*|\d+\.\d+|\[[^\]]+\])[^\"]*\"$",
    register_diagnostic(span=$attr, message="raw spacing utility in className — use a layout primitive (<Stack>, <Row>, <Section>, <Toolbar>) or an intent token (gap-section, p-row, py-block, gap-gutter). See docs/architecture/core/UI-Architecture-and-Layout.md.", severity="error")
  },
  `cn($args)` where {
    in_substrate_scope(),
    $args <: contains bubble `$str` as $lit where {
      $lit <: r"^\"[^\"]*\b(?:gap|p[xytrbl]?|m[xytrbl]?|space-[xy])-(?:[1-9]\d*|\d+\.\d+|\[[^\]]+\])[^\"]*\"$",
      register_diagnostic(span=$lit, message="raw spacing utility in cn() — use a layout primitive or intent token (gap-section, p-row, py-block, gap-gutter). See docs/architecture/core/UI-Architecture-and-Layout.md.", severity="error")
    }
  },
  `clsx($args)` where {
    in_substrate_scope(),
    $args <: contains bubble `$str` as $lit where {
      $lit <: r"^\"[^\"]*\b(?:gap|p[xytrbl]?|m[xytrbl]?|space-[xy])-(?:[1-9]\d*|\d+\.\d+|\[[^\]]+\])[^\"]*\"$",
      register_diagnostic(span=$lit, message="raw spacing utility in clsx() — use a layout primitive or intent token (gap-section, p-row, py-block, gap-gutter). See docs/architecture/core/UI-Architecture-and-Layout.md.", severity="error")
    }
  },
  `cva($args)` where {
    in_substrate_scope(),
    $args <: contains bubble `$str` as $lit where {
      $lit <: r"^\"[^\"]*\b(?:gap|p[xytrbl]?|m[xytrbl]?|space-[xy])-(?:[1-9]\d*|\d+\.\d+|\[[^\]]+\])[^\"]*\"$",
      register_diagnostic(span=$lit, message="raw spacing utility in cva() — use a layout primitive or intent token (gap-section, p-row, py-block, gap-gutter). See docs/architecture/core/UI-Architecture-and-Layout.md.", severity="error")
    }
  },
  `tv($args)` where {
    in_substrate_scope(),
    $args <: contains bubble `$str` as $lit where {
      $lit <: r"^\"[^\"]*\b(?:gap|p[xytrbl]?|m[xytrbl]?|space-[xy])-(?:[1-9]\d*|\d+\.\d+|\[[^\]]+\])[^\"]*\"$",
      register_diagnostic(span=$lit, message="raw spacing utility in tv() — use a layout primitive or intent token (gap-section, p-row, py-block, gap-gutter). See docs/architecture/core/UI-Architecture-and-Layout.md.", severity="error")
    }
  }
}
