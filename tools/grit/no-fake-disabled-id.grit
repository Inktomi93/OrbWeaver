// Plugin: no-fake-disabled-id — `castId("")` (an empty-string branded id) is the neo sentinel for
// "query disabled": paired with `enabled:` it works until someone drops the guard, and then the
// EMPTY ID HITS THE SERVER (UI-Gates §11.5 — ~10 sites in neo). The type-safe replacement is
// `useGatedQuery`/`skipToken` (data/use-gated-query.ts): a null id never builds the key at all.
language js

or {
  `castId("")`,
  `castId<$_>("")`
} as $node where {
  // Client-scoped: the sentinel's failure mode is a disabled QUERY going live. A server-side empty
  // branded value is a different (FLAGged, deliberate) class — not this rule's business.
  $filename <: r".*/packages/client/src/.*",
  register_diagnostic(span=$node, message="empty-string branded id (the fake-disabled sentinel) — if the enabled: guard is ever dropped, the empty id hits the server. Use useGatedQuery/skipToken (a null id never builds the key). See UI-Gates-and-Lessons.md §11.5.")
}
