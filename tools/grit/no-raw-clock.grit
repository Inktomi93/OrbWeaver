// Plugin: no-raw-clock — `Date.now()` or `new Date()` (the no-arg "now") outside the time seam.
// Production reads time from the INJECTED clock / `@orb/kit/time`, never ambient now — the same
// injection seam tests use for determinism. `new Date(ms)` (parsing a KNOWN timestamp) is allowed
// (it takes an arg, so it isn't matched). Exempt: the seam (`@orb/kit/time`), the composition root
// (`entry/`, which builds the clock), and tests/tooling/scripts.
// Refs: spine/typescript-style.md §3, spine/testing.md §3 (determinism), tiers/entry.md (injection).
language js

or {
  `Date.now()`,
  `new Date()`
} as $node where {
  $filename <: not or {
    r".*/packages/kit/src/time\.ts$",
    r".*/packages/server/src/entry/.*",
    r".*\.test\.tsx?$",
    r".*/tests/.*",
    r".*/scripts/.*",
    r".*/tools/.*"
  },
  register_diagnostic(span=$node, message="raw Date.now() / new Date() — production reads time from the injected clock (@orb/kit/time), never ambient now (determinism: the same seam tests use). `new Date(ms)` to parse a known timestamp is fine. See spine/typescript-style.md §3.")
}
