{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Shared base. Per-package tsconfigs `extends` this; `${configDir}` (TS 5.5+) resolves
  // `include`/`tsBuildInfoFile` relative to the LEAF package, so one base serves all five.
  "compilerOptions": {
    // --- emit: tsc is the type ORACLE only. tsx runs TS directly; the bundler builds the client. ---
    "noEmit": true,
    // EVERY program may import a sibling with its explicit `.ts` extension. Safe under `noEmit` (tsc is
    // the type ORACLE; nothing here emits). Flipped from root-only 2026-08-03 by the tsx-shedding
    // migration stage 1: extension-ful relative imports are now the CONVENTION, not a scripts/ exception,
    // because node's type-stripping does no extensionless resolution. `useImportExtensions` (biome) is the
    // permanent enforcer.
    "allowImportingTsExtensions": true,
    "incremental": true,
    // tsc is the type ORACLE — never truncate a deep contracts/db type with `...` in a diagnostic.
    // (Probe-VERIFIED honored by the ts7 oracle — typescript 7.0.2, 2026-08-03: without it a 12-member
    // anonymous union prints `... 6 more ...`; with it, the full union.)
    "noErrorTruncation": true,
    // Cache lives in the package's own node_modules → per-worktree + gitignored.
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/tsbuildinfo.json",
    "skipLibCheck": true,

    // --- language / module (TS 6 defaults made explicit) ---
    "target": "es2025",
    // `esnext.disposable` on top of es2025 (node-26 adoption program §1.1, 2026-08-03). The runtime has
    // explicit resource management — `using`/`await using` execute natively under node 26 — but TS's
    // es2025 lib does not declare `Symbol.dispose`/`Disposable`, so the spelling W5 adopts is UNTYPED
    // without this. `esnext.disposable` is the MINIMAL delta that takes it (probe-verified: switching the
    // whole lib to `esnext` clears the same thing and nothing else we need). The two browser programs
    // (packages/{ui,client}/tsconfig.json) and tsconfig.tests-dom.json compose their OWN lib arrays and
    // carry the same entry beside their dom entries. The V8 14.6 surfaces TS ships in NO lib yet
    // (Map.getOrInsert, Error.isError, Iterator.concat) come from the root platform.d.ts instead.
    "lib": ["es2025", "esnext.disposable"],
    // NODENEXT on the node side (tsx-shedding stage 4, 2026-08-03). This is the ENFORCEMENT half of the
    // migration: under `bundler` the checker still ACCEPTS an extensionless relative import, so a missed
    // extension typechecks GREEN and then crashes at boot under node's type-stripping (which does no
    // extensionless resolution) — with only a lint rule in between. Under nodenext it is a COMPILE ERROR.
    // The browser packages override back to esnext/bundler below: vite is their resolver and that is
    // honest. kit/contracts stay nodenext = strictest-consumer-wins (node-strict is a subset vite accepts).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    // Honor package.json `exports`/`imports` resolution explicitly. Default-true under `bundler`;
    // pinned to harden our exports/#imports contract + survive a future moduleResolution change.
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "resolveJsonModule": true,
    "allowJs": false,

    // --- module syntax: every file is an erasable, type-only-import module (node can strip + run) ---
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "noUncheckedSideEffectImports": true,

    // isolatedDeclarations: CONSIDERED-REJECTED (2026-08-03 full-catalog audit) — this is a noEmit
    // oracle; no program emits declarations (cross-package types resolve to SOURCE via exports maps),
    // so the flag buys nothing and its annotate-every-export tax fights the z.infer-derive doctrine.
    // Every other absent option in the 129-option catalog is absent by architecture (emit family,
    // projects/references, legacy compat) — see the 2026-08-03 audit before "completing" this config.

    // --- strictness: everything on, out of the gate (these hurt to retrofit later) ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,

    // No tsconfig `paths` (principle #2): cross-package = package names, intra-package = the
    // package.json `imports` field (`#*`). `types: []` keeps ambient @types out unless a package opts in.
    "types": []
  },
  // `${configDir}/../../reset.d.ts` → the repo-root ts-reset import; every package lives at
  // packages/<name>, so `../../` always resolves to root. Declaration-only, no emit.
  // `platform.d.ts` rides the SAME distribution mechanism (node-26 adoption program §1.2): the V8 14.6
  // surfaces TypeScript ships in no lib yet. The three programs that OVERRIDE this include
  // (tsconfig.json, tsconfig.tests-dom.json) and the three package configs that do
  // (packages/{ui,client,db}) each list BOTH files themselves — an override drops this line entirely.
  "include": ["${configDir}/src", "${configDir}/../../reset.d.ts", "${configDir}/../../platform.d.ts"],
  // `__g_*` is the RESERVED sentinel prefix the check-gates self-test (tests/tooling/check-gates.int.test.ts)
  // materializes throwaway violation fixtures under — they exist for milliseconds inside one test then are
  // rm'd. tsc/biome/vitest/eslint/depcruise all glob the real tree, so a CONCURRENT typecheck could catch a
  // fixture mid-lifecycle → a phantom error that vanishes on re-run (the "never run `pnpm test` alongside
  // `pnpm check`" footgun). Excluding the sentinel here (mirrored in tsconfig.json/biome.json/vitest.config.ts/
  // eslint.config.js/.dependency-cruiser.cjs) makes the self-test hermetic: the gate harness reads fixtures via
  // ts-morph's OWN globs (skipAddingFilesFromTsConfig — unaffected by this exclude), so it still fires on them.
  // Specifying `exclude` overrides tsc's default, so node_modules is re-listed to keep it out.
  "exclude": ["**/node_modules", "**/__g_*", "**/__g_*/**"]
}
