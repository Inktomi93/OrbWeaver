{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Abstract strictness base. World templates compose environment options; leaf configs
  // own roots and ambient scopes. `files: []` keeps this out of the program roster.
  "compilerOptions": {
    // Native Node runs erasable source; Vite builds the browser. The router config overrides this to emit declarations.
    "noEmit": true,
    // Native Node requires explicit source extensions; noEmit and declaration-only emit both permit them.
    "allowImportingTsExtensions": true,
    // Incremental is off deliberately: the compiler decides a project is up to date from LOCAL file
    // hashes, so editing a root ambient `.d.ts` (`reset.d.ts`, `platform.d.ts`) does not invalidate
    // per-package state — a warm run reports green on a red tree. `tsc` here is noEmit-only, so
    // incremental bought nothing but speed.
    // RE-ENABLE ONLY WITH A PROOF: edit `platform.d.ts` to something that must red (property-style
    // `getOrInsert` reds its use sites), run typecheck WITHOUT clearing caches, and require a
    // non-zero exit. If restored: `${configDir}` is the tsconfig's own directory, so
    // `tsconfig.json` and `tsconfig.tests-dom.json` at the repo root would share one cache file
    // across two programs — give tests-dom its own `tsBuildInfoFile` first.
    // tsc is the type oracle: never truncate a deep contracts/db type with `...` in a diagnostic.
    "noErrorTruncation": true,
    "skipLibCheck": false,

    // --- language / module (TS 6 defaults made explicit) ---
    "target": "es2025",
    // `esnext.disposable` on top of es2025: the runtime has
    // explicit resource management — `using`/`await using` execute natively under node 26 — but TS's
    // es2025 lib does not declare `Symbol.dispose`/`Disposable`, so the spelling W5 adopts is UNTYPED
    // without this. `esnext.disposable` is the MINIMAL delta that takes it (probe-verified: switching the
    // whole lib to `esnext` clears the same thing and nothing else we need). The browser-world
    // template composes its lib array from this authoritative common list plus the DOM delta. The V8 14.6 surfaces TS ships in NO lib yet
    // (Map.getOrInsert, Error.isError, Iterator.concat) come from the root platform.d.ts instead.
    // `esnext.temporal`: `@orb/kit/time` runs on the platform `Temporal` API. Node 26 and
    // chromium ≥144 both ship it enabled by default, but no `es*` lib declares it — TS 6.0.3 and ts7
    // 7.0.2 BOTH carry `lib.esnext.temporal.d.ts`, so the lib entry is the whole type story and
    // `platform.d.ts` needs no block. Probe-verified with a planted negative control: drop this entry and
    // a `Temporal.Instant` reference reds `TS2304: Cannot find name 'Temporal'`. Cross-package types resolve
    // to SOURCE, so every program that sees kit needs it.
    "lib": ["es2025", "esnext.disposable", "esnext.temporal"],
    // NODENEXT on the node side is the ENFORCEMENT half of the
    // migration: under `bundler` the checker still ACCEPTS an extensionless relative import, so a missed
    // extension typechecks GREEN and then crashes at boot under node's type-stripping (which does no
    // extensionless resolution) — with only a lint rule in between. Under nodenext it is a COMPILE ERROR.
    // The browser packages override back to esnext/bundler below: vite is their resolver and that is
    // honest. kit/contracts stay nodenext = strictest-consumer-wins (node-strict is a subset vite accepts).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    // Honor package.json `exports`/`imports` resolution explicitly. Default-true under `bundler`;
    // pinned to harden our exports/#imports contract + survive a future moduleResolution change.
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "resolveJsonModule": true,
    "allowJs": false,

    // --- module syntax: every file is an erasable, type-only-import module (node can strip + run) ---
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "noUncheckedSideEffectImports": true,

    // AppRouter declarations retain inferred Zod/procedure types; isolatedDeclarations would require explicit annotations.

    // --- strictness: everything on, out of the gate (these hurt to retrofit later) ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,

    // No tsconfig `paths` (principle #2): cross-package = package names, intra-package = the
    // package.json `imports` field (`#*`). `types: []` disables automatic @types inclusion, not explicit imports or dependency references.
    "types": []
  },
  "files": []
}
