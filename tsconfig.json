{
  // Root AGGREGATING tsconfig — NOT used by `pnpm typecheck` (that runs per-package via `pnpm -r exec
  // tsc`, each package's own tsconfig.json), and NOT used by dependency-cruiser (verified 2026-06-26:
  // its resolution + type-only detection are identical with/without it). Its real consumers arrive next:
  // vitest's type lane (the `.test-d.ts` project) and Stryker's typescript-checker (Phase 4) both default
  // tsconfigFile to `tsconfig.json`. Extends the base + widens `include` to the whole graph (the base's
  // `${configDir}/src` would only see a root src/).
  // This aggregator typechecks node-context code (`scripts/` tooling + `tests/` harnesses use
  // `node:*`), so it adds `@types/node` on top of the isomorphic base (`types: []`). This does NOT
  // weaken kit-purity: that is enforced per-package (each package's own `tsconfig` keeps `types: []`)
  // + the dep-cruiser `kit-purity` gate — never by this root config.
  "extends": "./tsconfig.base.json",
  // `allowImportingTsExtensions` (safe under the base's `noEmit`): the `scripts/` tooling imports
  // siblings with explicit `.ts` extensions (tsx-run); this aggregator must permit that to typecheck them.
  // `jsx`: the aggregator sweeps tests/**/*.ct.tsx + playwright/index.tsx (the CT harness) — both
  // JSX in node-checked space; per-package jsx stays in each package's own tsconfig.
  "compilerOptions": { "types": ["node"], "allowImportingTsExtensions": true, "jsx": "react-jsx" },
  "include": ["packages/*/src", "scripts", "tests", "playwright", "reset.d.ts"]
}
