{
  // DOM-less Node test/tooling program. Browser package source has its own programs; imported pure
  // helpers may enter this closure. Package NodeNext checks separately enforce runtime resolution.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "packages/*/src",
    "scripts",
    "tooling/src",
    "tests",
    "reset.d.ts",
    "platform.d.ts",
    "aggregator-assets.d.ts",
    // This script-kind SDK declaration belongs to its conformance test, never the server program.
    "packages/showcase-plugins/bundles/host-v1.d.ts",
    "vitest.config.ts",
    "vitest.stryker.config.ts",
    "playwright.config.ts",
    "knip.ts"
  ],
  // Browser tests declare their compiler world by suffix; browser-only drivers and helpers by home.
  // __g_* is transient gate-fixture state; the foreign capture is not authored repository source.
  "exclude": [
    "**/node_modules",
    "packages/ui/src",
    "packages/client/src",
    "tests/**/*.dom.test.ts",
    "tests/**/*.dom.test-d.ts",
    "tests/e2e",
    "tests/support/browser",
    "**/*.tsx",
    "playwright",
    "scripts/probes/st-goldens",
    "scripts/probes/st-goldens/sillytavern-runtime",
    "**/__g_*",
    "**/__g_*/**"
  ]
}
