{
  "extends": "./tsconfig.world-node.json",
  "compilerOptions": {
    "jsx": "react-jsx"
  },
  "include": [
    "reset.d.ts",
    "platform.d.ts",
    "aggregator-assets.d.ts",
    "packages/showcase-plugins/bundles/host-v1.d.ts",
    "*.config.ts",
    "knip.ts",
    "packages/*/*",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.cts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "tests/**/*.cts",
    "tests/support/node/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/__g_*",
    "**/__g_*/**",
    "tests/**/*.dom.test-d.ts",
    "tests/**/*.dom.test.ts",
    "tests/**/*.spec.ts",
    "tests/**/*.ct.tsx",
    "tests/e2e",
    "tests/support/browser",
    "tests/support/iso/**/*",
    "playwright",
    "scripts/probes/st-goldens",
    "scripts/probes/st-goldens/sillytavern-runtime"
  ]
}
