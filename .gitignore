# --- secrets & local state (NEVER commit) ---
.credentials-key          # the ONLY decryption recovery path — must stay local
.env
.env.*
!.env.example
# container: your settings + the file-secrets overlay's files (docker/README.md)
docker/orbweaver.local.env
docker/secrets/*
!docker/secrets/README.md
*.pem
*.key

# --- local databases ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Root-anchored: the runtime db dir ONLY. Unanchored `data/` silently ate the client's
# `src/data/` source layer at commit time (git add skipped it; the tree shipped without it).
/data/

# --- node / pnpm ---
node_modules/
.pnpm-store/
.pnpm-debug.log*

# --- build output ---
dist/
build/
out/
*.tsbuildinfo
# `build/` above is build OUTPUT; the memory "build" tier (digest/segment generation) is SOURCE — un-ignore it.
!packages/server/src/domain/chat/memory/build/
!tests/server/domain/chat/memory/build/

# --- test / coverage ---
coverage/
.vitest/
*.lcov

# --- quality tooling output (jscpd reports, stryker sandbox + reports) ---
# mutation-probe's crash-recovery marker: it carries a PRISTINE source body and only exists while a
# probe is mid-plant. Committing one would be committing a half-finished experiment's state.
/.mutation-probe-active.json
# Root-anchored: ignores the tool-output dir at repo root only, NOT the tracked
# architecture docs in docs/architecture/reports/ (the ledger, ENFORCEMENT, etc.).
/reports/
.stryker-tmp/
# Stryker's per-worker setup files leak to the repo root (the mutation runner); generated + transient,
# never committed. Biome (useIgnoreFile) skips them too, so they stop reddening the gate.
/stryker-setup-*.js

# --- caches ---
.turbo/
.cache/
.eslintcache

# --- local model weights (HF cache; pinned in-repo by the vLLM dev scripts) ---
.models/

# --- logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- git hooks (lefthook local overrides) ---
lefthook-local.yml

# --- Claude Code: share the project hook (settings.json), keep personal overrides local ---
.claude/settings.local.json
# work-item CLI project-context cache (scripts/github/work-item.ts) — derived, refetchable
.claude/cache/

# --- editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- read-only reference corpus (neo-tavern source + upstream cite targets + design goals) ---
# Root-anchored (the /data/ lesson). NEVER committed: ~258M of frozen evidence the docs cite
# one-line (ST tool-calling.js etc.), mirrored so dev-container sessions can verify references.
# NB search tools that respect ignore files skip this — use /usr/bin/grep -a or `sg --no-ignore`.
/reference/

# --- the dev bug-found button's durable captures (#1095) ---
# Root-anchored (the /data/ lesson). One JSON bundle + one markdown note per report, written by
# /api/_debug/bug-report at capture time. The owner's raw session evidence — read at the review ritual,
# quoted into an issue, never committed (they carry whatever the page and the flight recorders held).
/bug-reports/

# --- scratch ---
scratchpad/
scratch/
/tmp/

# transient agent worktrees (EnterWorktree / subagent isolation)
.claude/worktrees/
.claude/agent-memory/

# browser-automation snapshot artifacts (live-verify)
.playwright-mcp/

# SillyTavern data snapshot (copied from neo-tavern) — import fodder for the ST-profile loader; never committed
.st-data/

# --- reserved throwaway-fixture sentinels (transient test artifacts; a crashed run can orphan them, and
# they must never reach git).
# `__g_*` now has exactly ONE producer, and it is not a gate fixture: `tooling/src/verify/lib/biome-rule-liveness.ts`
# writes a repo-root `__g_biome-rule-liveness.<pid>.json` probe (`PROBE_PREFIX`, :17) and reaps it. The LEGACY
# gate self-test's planters that minted this namespace retired at #2176 Phase F (2026-09-14); the biome
# negation `!**/__g_*` in biome.json:24 is the other half of this one surviving owner, because biome honours
# this file through `vcs.useIgnoreFile` and would otherwise refuse to lint the probe's own path.
# `__dc*` is the dependency-cruiser self-test's live planter (tests/tooling/dependency-cruiser.int.test.ts).
**/__g_*
**/__dc*
# The constitution's scratch-probe idiom (AGENTS §4: plant at `features/__probe/...`, rm after) and
# the cp-probe backup discipline (`cp f f.bak; ...; mv f.bak f`) — transient by definition; visible
# untracked, they read as mystery files to sibling lanes (owner, 2026-08-21).
**/__probe*
*.bak

# st-parity goldens rig: the runtime AND everything generated (fixtures are emitted by
# build-fixtures.ts + the run-demo scripts; outputs are captures). Only scripts + README are tracked.
# The runtime is ALSO fenced from the ts-morph search project by glob (scripts/ts-workspace.ts) — a
# gitignore alone does not stop `addSourceFilesAtPaths`.
/scripts/probes/st-goldens/sillytavern-runtime/
/scripts/probes/st-goldens/fixtures/
/scripts/probes/st-goldens/output/
/scripts/probes/st-goldens/orbweaver-output/
/scripts/probes/st-goldens/debug-st.png

# vite --profile output (`vite build --profile` / `vite --profile`) — a ~25 MB V8 CPU profile written
# to the invoking package root, for speedscope.app. An instrument's output, never an artifact we keep;
# how to read one is documented in packages/client/vite.config.ts's header.
*.cpuprofile

.claude/apisurface-*.txt

# External agent workspaces
.lsp.json
.qwen/
