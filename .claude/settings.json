{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tool-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/biome-check.sh"]
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-setup.sh",
            "timeout": 300,
            "statusMessage": "Creating worktree + installing deps"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-remove.sh",
            "timeout": 120,
            "statusMessage": "Removing worktree"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-onboard.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/orchestrator-inject.mjs", "1"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/orchestrator-inject.mjs", "2"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm check *)",
      "Bash(pnpm check:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:types)",
      "Bash(pnpm test:types *)",
      "Bash(pnpm test:ct *)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc --noEmit *)",
      "Bash(pnpm -r exec tsc --noEmit *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint:eslint)",
      "Bash(pnpm lint:eslint *)",
      "Bash(pnpm depcruise)",
      "Bash(pnpm depcruise *)",
      "Bash(pnpm snap *)",
      "Bash(/usr/bin/grep *)",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_console_logs",
      "mcp__Claude_Preview__preview_list",
      "mcp__Claude_Preview__preview_snapshot",
      "mcp__Claude_Preview__preview_inspect",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(sed -n *)",
      "Bash(python3 -c *)",
      "Bash(command -v *)",
      "Bash(which *)",
      "Bash(date *)",
      "Bash(ps *)",
      "Bash(ast-grep *)",
      "Bash(pnpm ast *)",
      "Bash(npx ast-grep *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git worktree list)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git -C *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm verify *)",
      "Bash(pnpm e2e:smoke)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm install *)",
      "Bash(rm -rf playwright/.cache)"
    ]
  }
}
