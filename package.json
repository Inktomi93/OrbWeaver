{
  "name": "orbweaver",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "ci:contributor-ready": "node scripts/ci/contributor-ready.ts",
    "ci:contributor-stop": "node scripts/ci/contributor-stop.ts",
    "prepare": "node scripts/prepare.ts",
    "deps:update": "node scripts/deps-update.ts",
    "sync": "bash scripts/github-sync.sh",
    "release": "bash scripts/github-sync.sh --release",
    "build": "pnpm --filter @orb/server check:media && pnpm --filter @orb/showcase-plugins build && pnpm --filter @orb/ui tokens:build && pnpm --filter @orb/client build",
    "build:version-stamp": "node scripts/build-version-stamp.ts",
    "start": "node tooling/src/stack/cli.ts start",
    "doc": "node tooling/src/doc/cli.ts",
    "share": "node tooling/src/stack/cli.ts start --share",
    "dev": "node tooling/src/dev/cli.ts",
    "worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
    "stack": "node tooling/src/stack/cli.ts",
    "fixture": "node tooling/src/stack/cli.ts fixture",
    "seed:demo": "node tooling/src/seed/cli.ts demo",
    "snap": "node tooling/src/snap/cli.ts",
    "snap:devtools-assets": "node tooling/src/snap/cli.ts --materialize-devtools-assets",
    "bug:reports": "node tooling/src/bug-reports/cli.ts",
    "knip": "knip",
    "knip:prod": "knip --production --strict",
    "codemod": "codemod --disable-analytics",
    "plugin:pack": "node scripts/pack-plugin.ts",
    "plugin:author-release": "node scripts/release-plugin-authoring.ts",
    "sse-tap": "node --experimental-eventsource tooling/src/wire-tap/cli.ts sse",
    "cache:check": "node tooling/src/cache-check/cli.ts",
    "trace:render": "node tooling/src/render-trace/cli.ts render",
    "trace:tail": "node tooling/src/render-trace/cli.ts tail",
    "trace:fire": "node tooling/src/render-trace/cli.ts fire",
    "sandbox": "bash scripts/dev/sandbox.sh",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:docs": "node tooling/src/doc/cli.ts format --write",
    "depcruise": "depcruise packages tooling tests scripts playwright .claude/hooks *.config.ts *.config.js *.d.ts knip.ts stylelint-rules.js .dependency-cruiser.ts --config .dependency-cruiser.ts --output-type err-long",
    "depcruise:graph": "mkdir -p reports && depcruise packages tooling tests scripts playwright .claude/hooks *.config.ts *.config.js *.d.ts knip.ts stylelint-rules.js .dependency-cruiser.ts --config .dependency-cruiser.ts --output-type mermaid --collapse '^packages/(server/src/[^/]+|client/src/[^/]+|[^/]+)|^(tooling|tests|scripts|playwright)/[^/]+|^node_modules/(@[^/]+/[^/]+|[^/]+)' --output-to reports/dependency-graph.mmd",
    "test": "vitest run --config=vitest.config.ts --exclude=\"tests/tooling/**\"",
    "test:coverage": "vitest run --config=vitest.config.ts --exclude=\"tests/tooling/**\" --coverage",
    "e2e": "playwright test --config=playwright.config.ts",
    "e2e:smoke": "E2E_LIVE=0 E2E_ALLOW_DEV_TARGET=0 node tooling/src/floor/process/niced-exec.ts playwright test -c playwright.config.ts --project=single-user --grep @smoke",
    "e2e:corpus": "node scripts/corpus-fixture.ts e2e -- --grep=@corpus",
    "e2e:corpus:matrix": "node scripts/corpus-fixture.ts matrix --",
    "e2e:live": "E2E_LIVE=1 node tooling/src/floor/process/niced-exec.ts playwright test -c playwright.config.ts start-chat-with-character.spec.ts",
    "cpd": "node scripts/cpd.ts -c jscpd.json",
    "typecheck": "node scripts/typecheck.ts",
    "lint:eslint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0",
    "lint:css": "stylelint \"packages/**/*.css\"",
    "test:ct": "playwright test --config=playwright-ct.config.ts --project=chromium",
    "test:tools": "vitest run --config=vitest.config.ts --exclude=\"tests/!(tooling)/**\""
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@biomejs/biome": "catalog:",
    "@codemod.com/jssg-types": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@orb/client": "workspace:*",
    "@orb/contracts": "workspace:*",
    "@orb/db": "workspace:*",
    "@orb/default-content": "workspace:*",
    "@orb/inference": "workspace:*",
    "@orb/kit": "workspace:*",
    "@orb/plugin-toolchain": "workspace:*",
    "@orb/server": "workspace:*",
    "@orb/showcase-plugins": "workspace:*",
    "@orb/testkit": "workspace:*",
    "@orb/tooling": "workspace:*",
    "@orb/ui": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/oxide": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@total-typescript/ts-reset": "catalog:",
    "@trpc/client": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "codemod": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-drizzle": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-web-api": "catalog:",
    "eslint-plugin-react-x": "catalog:",
    "eslint-plugin-react-you-might-not-need-an-effect": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "fflate": "catalog:",
    "hono": "catalog:",
    "isomorphic-git": "catalog:",
    "jose": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "lighthouse": "catalog:",
    "openid-client": "catalog:",
    "pino-pretty": "catalog:",
    "postcss-value-parser": "catalog:",
    "puppeteer-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "typeid-js": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "imports": {
    "#client/*": "./packages/client/src/*",
    "#contracts/*": "./packages/contracts/src/*",
    "#db/*": "./packages/db/src/*",
    "#default-content/*": "./packages/default-content/src/*",
    "#inference/*": "./packages/inference/src/*",
    "#kit/*": "./packages/kit/src/*",
    "#plugin-toolchain/*": "./packages/plugin-toolchain/src/*",
    "#server/*": "./packages/server/src/*",
    "#showcase-plugins/*": "./packages/showcase-plugins/src/*",
    "#ui/*": "./packages/ui/src/*"
  }
}
