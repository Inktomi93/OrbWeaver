    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-web-api": "catalog:",
    "eslint-plugin-react-you-might-not-need-an-effect": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "fflate": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "jscpd": "catalog:",
    "knip": "^6.27.0",
    "lefthook": "catalog:",
    "pino-pretty": "catalog:",
    "quickjs-emscripten-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "ts-morph": "catalog:",
    "ts7": "npm:typescript@7.0.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "undici": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.0",
    "zod": "catalog:",
    "zustand": "catalog:"
  }
}
