{
  "name": "orbweaver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs --output-type err-long",
    "depcruise:affected": "depcruise packages --config .dependency-cruiser.cjs --output-type err-long --affected",
    "depcruise:graph": "mkdir -p reports && depcruise packages --config .dependency-cruiser.cjs --output-type mermaid --output-to reports/dependency-graph.mmd",
    "depcruise:focus": "depcruise packages --config .dependency-cruiser.cjs --output-type mermaid --focus",
    "depcruise:reaches": "depcruise packages --config .dependency-cruiser.cjs --output-type mermaid --reaches",
    "check:structure": "tsx scripts/check/report.ts",
    "test": "vitest run --project unit --project integration --project contract",
    "test:types": "vitest run --project types",
    "test:parity": "vitest run --project parity",
    "test:coverage": "vitest run --coverage",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "e2e": "playwright test -c playwright.config.ts",
    "cpd": "jscpd -c jscpd.json",
    "cpd:report": "jscpd -c jscpd.json --reporters html --output reports/cpd",
    "test:mutation": "stryker run stryker.config.json",
    "test:mutation:gate": "stryker run stryker.gate.config.json",
    "check": "pnpm lint && pnpm typecheck && pnpm check:structure && pnpm depcruise"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/experimental-ct-react": "catalog:",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@total-typescript/ts-reset": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "jscpd": "catalog:",
    "lefthook": "catalog:",
    "ts-morph": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
