{
  "name": "orbweaver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "agents:sync": "node tooling/src/agent-sync/cli.ts",
    "check:agents": "node tooling/src/agent-sync/cli.ts --check",
    "worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
    "work:item": "node tooling/src/workboard/cli.ts",
    "stack": "bash tooling/src/stack/stack.sh",
    "fixture": "bash tooling/src/stack/multi-user-fixture.sh",
    "seed:demo": "node tooling/src/seed/cli.ts demo",
    "design-audit": "node tooling/src/ui-audit/cli.ts",
    "snap": "node tooling/src/snap/cli.ts",
    "ast": "node tooling/src/ast/cli.ts",
    "codemod": "node tooling/src/codemod/cli.ts",
    "knip": "knip --cache",
    "knip:prod": "knip --cache --production --strict",
    "record": "node tooling/src/screen-record/cli.ts",
    "perf-meter": "node tooling/src/cpu-profile/cli.ts",
    "motion-audit": "node tooling/src/motion-audit/cli.ts",
    "sdk:behavior-probe": "node scripts/probes/sdk-behavior-probe.ts",
    "sdk:cache-probe": "node scripts/probes/sdk-cache-probe.ts",
    "sdk:dynamic-probe": "node scripts/probes/sdk-dynamic-content-probe.ts",
    "sdk:injection-cache-probe": "node scripts/probes/sdk-injection-cache-probe.ts",
    "sdk:session-probe": "node scripts/probes/sdk-session-probe.ts",
    "probe:history-system-rows": "node scripts/probes/history-system-rows.ts",
    "sse-tap": "node --experimental-eventsource tooling/src/wire-tap/cli.ts sse",
    "trace:render": "node tooling/src/render-trace/cli.ts render",
    "trace:tail": "node tooling/src/render-trace/cli.ts tail",
    "trace:fire": "node tooling/src/render-trace/cli.ts fire",
    "sandbox": "bash scripts/dev/sandbox.sh",
    "engines": "bash tooling/src/stack/engines.sh",
    "engines:start": "bash tooling/src/stack/engines.sh start",
    "engines:stop": "bash tooling/src/stack/engines.sh stop",
    "engines:status": "bash tooling/src/stack/engines.sh status",
    "engines:sleep": "bash tooling/src/stack/engines.sh sleep",
    "engines:wake": "bash tooling/src/stack/engines.sh wake",
    "engines:reconcile": "bash tooling/src/stack/engines.sh reconcile",
    "typecheck": "pnpm -r exec node $PWD/scripts/ts7.cjs --checkers 8 --noEmit --pretty false",
    "typecheck:graph": "node scripts/ts7.cjs --checkers 8 --noEmit --pretty false -p tsconfig.json",
    "typecheck:tests-dom": "node scripts/ts7.cjs --checkers 8 --noEmit --pretty false -p tsconfig.tests-dom.json",
    "prose:baseline": "node tooling/src/verify/cli.ts baseline prose",
    "check:tests-membership": "node tooling/src/verify/cli.ts tests-membership",
    "check:tests-execution-membership": "node tooling/src/verify/cli.ts tests-execution-membership",
    "check:db-baseline": "node tooling/src/verify/cli.ts db-baseline",
    "check:drizzle-kit": "pnpm --filter @orb/db exec drizzle-kit check --config=drizzle.config.ts",
    "check:orphan-ratchet": "node tooling/src/verify/cli.ts orphan-ratchet",
    "check:boot-chunk": "node tooling/src/verify/cli.ts boot-chunk",
    "check:respell": "node tooling/src/ast/cli.ts respell",
    "check:swallowed": "node tooling/src/ast/cli.ts swallowed",
    "check:typeonly": "node tooling/src/ast/cli.ts typeonly-alive",
    "check:columns": "node tooling/src/ast/cli.ts columns",
    "check:regkeys": "node tooling/src/ast/cli.ts regkeys",
    "check:chains": "node tooling/src/ast/cli.ts chains",
    "lint": "biome check . --diagnostic-level=error --reporter=concise",
    "lint:eslint": "eslint packages/ui packages/client packages/server packages/kit packages/db packages/contracts tooling/src tests --max-warnings 0 --cache --cache-strategy content",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:docs": "node tooling/src/doc-catalog/cli.ts format --write",
    "check:docs": "node tooling/src/doc-catalog/cli.ts format --check",
    "doc-catalog:write": "node tooling/src/doc-catalog/cli.ts catalog --write",
    "doc-catalog:sync": "node tooling/src/doc-catalog/cli.ts catalog --sync",
    "doc-catalog:ratchet": "node tooling/src/doc-catalog/cli.ts catalog --ratchet",
    "check:doc-catalog": "node tooling/src/doc-catalog/cli.ts catalog --check",
    "depcruise": "depcruise packages tooling --config .dependency-cruiser.cjs --output-type err-long",
    "depcruise:affected": "depcruise packages tooling --config .dependency-cruiser.cjs --output-type err-long --affected",
    "depcruise:graph": "mkdir -p reports && depcruise packages tooling --config .dependency-cruiser.cjs --output-type mermaid --output-to reports/dependency-graph.mmd",
    "depcruise:focus": "depcruise packages tooling --config .dependency-cruiser.cjs --output-type mermaid --focus",
    "depcruise:reaches": "depcruise packages tooling --config .dependency-cruiser.cjs --output-type mermaid --reaches",
    "gate:new": "node tooling/src/verify/cli.ts new-gate",
    "check:structure": "node tooling/src/verify/cli.ts structure",
    "check:show": "node tooling/src/verify/cli.ts show",
    "debt": "node tooling/src/verify/cli.ts debt",
    "test": "nice -n 19 vitest run --project unit --project integration --project integration-serial --project contract --reporter=default --reporter=json --outputFile.json=reports/test-report.json && pnpm test:ct --retries=2",
    "test:types": "nice -n 19 vitest run --project types",
    "test:coverage": "nice -n 19 vitest run --coverage",
    "test:ct": "rm -rf playwright/.cache && nice -n 19 playwright test -c playwright-ct.config.ts",
    "test:scoped": "nice -n 19 vitest run",
    "ct:scoped": "rm -rf playwright/.cache && nice -n 19 playwright test -c playwright-ct.config.ts",
    "e2e": "nice -n 19 playwright test -c playwright.config.ts",
    "e2e:smoke": "nice -n 19 playwright test -c playwright.config.ts --grep @smoke",
    "e2e:live": "E2E_LIVE=1 nice -n 19 playwright test -c playwright.config.ts start-chat-with-character.spec.ts",
    "cpd": "jscpd -c jscpd.json",
    "cpd:report": "jscpd -c jscpd.json --reporters html --output reports/cpd",
    "test:mutation": "nice -n 19 stryker run stryker.config.json",
    "test:mutation:gate": "nice -n 19 stryker run stryker.gate.config.json",
    "check": "nice -n 19 node tooling/src/verify/cli.ts run --static",
    "verify": "nice -n 19 node tooling/src/verify/cli.ts run"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@biomejs/biome": "catalog:",
    "@orb/client": "workspace:*",
    "@orb/contracts": "workspace:*",
    "@orb/db": "workspace:*",
    "@orb/kit": "workspace:*",
    "@orb/server": "workspace:*",
    "@orb/tooling": "workspace:*",
    "@orb/ui": "workspace:*",
    "@playwright/experimental-ct-react": "catalog:",
    "@playwright/test": "catalog:",
    "@stryker-mutator/api": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@total-typescript/ts-reset": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-web-api": "catalog:",
    "eslint-plugin-react-you-might-not-need-an-effect": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "fflate": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "jscpd": "catalog:",
    "knip": "^6.27.0",
    "lefthook": "catalog:",
    "pino-pretty": "catalog:",
    "quickjs-emscripten-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "ts-morph": "catalog:",
    "ts7": "npm:typescript@7.0.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "undici": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.0",
    "zod": "catalog:",
    "zustand": "catalog:"
  }
}
