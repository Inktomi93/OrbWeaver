{
  "name": "orbweaver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
    "work:item": "node scripts/github/work-item.ts",
    "dev": "bash scripts/dev/dev.sh",
    "stack": "bash scripts/dev/stack.sh",
    "seed:demo": "node scripts/seed/seed-demo.ts",
    "design-audit": "node scripts/probes/design-audit.ts",
    "snap": "node scripts/probes/snap.ts",
    "ast": "node scripts/codemods/ast.ts",
    "codemod": "node scripts/codemods/codemod.ts",
    "knip": "knip --cache",
    "knip:prod": "knip --cache --production --strict",
    "record": "node scripts/probes/record.ts",
    "perf-meter": "node scripts/probes/perf-meter.ts",
    "motion-audit": "node scripts/probes/motion-audit.ts",
    "sdk:behavior-probe": "node scripts/probes/sdk-behavior-probe.ts",
    "sdk:cache-probe": "node scripts/probes/sdk-cache-probe.ts",
    "sdk:dynamic-probe": "node scripts/probes/sdk-dynamic-content-probe.ts",
    "sdk:injection-cache-probe": "node scripts/probes/sdk-injection-cache-probe.ts",
    "sdk:session-probe": "node scripts/probes/sdk-session-probe.ts",
    "probe:history-system-rows": "node scripts/probes/history-system-rows.ts",
    "sse-tap": "node scripts/probes/sse-tap.ts",
    "trace:render": "node scripts/probes/trace-render.ts",
    "trace:tail": "node scripts/probes/trace-tail.ts",
    "trace:fire": "node scripts/probes/probe-fire.ts",
    "sandbox": "bash scripts/dev/sandbox.sh",
    "start": "NODE_ENV=production node packages/server/src/entry/index.ts",
    "engines": "bash scripts/dev/engines.sh",
    "engines:start": "bash scripts/dev/engines.sh start",
    "engines:stop": "bash scripts/dev/engines.sh stop",
    "engines:status": "bash scripts/dev/engines.sh status",
    "engines:sleep": "bash scripts/dev/engines.sh sleep",
    "engines:wake": "bash scripts/dev/engines.sh wake",
    "engines:reconcile": "bash scripts/dev/engines.sh reconcile",
    "typecheck": "pnpm -r exec node $PWD/scripts/ts7.cjs --checkers 8 --noEmit --pretty false",
    "typecheck:graph": "node scripts/ts7.cjs --checkers 8 --noEmit --pretty false -p tsconfig.json",
    "typecheck:tests-dom": "node scripts/ts7.cjs --checkers 8 --noEmit --pretty false -p tsconfig.tests-dom.json",
    "prose:baseline": "node scripts/check/gen-prose-baseline.ts",
    "check:tests-membership": "node scripts/verify/tests-type-membership.ts",
    "check:tests-execution-membership": "node scripts/verify/tests-execution-membership.ts",
    "check:db-baseline": "node scripts/verify/db-baseline-parity.ts",
    "check:drizzle-kit": "pnpm --filter @orb/db exec drizzle-kit check --config=drizzle.config.ts",
    "check:orphan-ratchet": "node scripts/verify/orphan-export-ratchet.ts",
    "check:respell": "node scripts/codemods/ast.ts respell",
    "check:swallowed": "node scripts/codemods/ast.ts swallowed",
    "check:typeonly": "node scripts/codemods/ast.ts typeonly-alive",
    "check:columns": "node scripts/codemods/ast.ts columns",
    "check:regkeys": "node scripts/codemods/ast.ts regkeys",
    "check:chains": "node scripts/codemods/ast.ts chains",
    "lint": "biome check . --diagnostic-level=error --reporter=concise",
    "lint:eslint": "eslint packages/ui packages/client tests/ui tests/client packages/server packages/kit packages/db packages/contracts --max-warnings 0 --cache --cache-strategy content",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:docs": "node scripts/docs/format-md.ts --write",
    "check:docs": "node scripts/docs/format-md.ts --check",
    "doc-catalog:write": "node scripts/docs/catalog.ts --write",
    "doc-catalog:sync": "node scripts/docs/catalog.ts --sync",
    "doc-catalog:ratchet": "node scripts/docs/catalog.ts --ratchet",
    "check:doc-catalog": "node scripts/docs/catalog.ts --check",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs --output-type err-long",
    "depcruise:affected": "depcruise packages --config .dependency-cruiser.cjs --output-type err-long --affected",
    "depcruise:graph": "mkdir -p reports && depcruise packages --config .dependency-cruiser.cjs --output-type mermaid --output-to reports/dependency-graph.mmd",
    "depcruise:focus": "depcruise packages --config .dependency-cruiser.cjs --output-type mermaid --focus",
    "depcruise:reaches": "depcruise packages --config .dependency-cruiser.cjs --output-type mermaid --reaches",
    "gate:new": "node scripts/check/new-gate.ts",
    "check:structure": "node scripts/check/report.ts",
    "check:show": "node scripts/check/show.ts",
    "test": "vitest run --project unit --project integration --project integration-serial --project contract --reporter=default --reporter=json --outputFile.json=reports/test-report.json && pnpm test:ct --retries=2",
    "test:types": "vitest run --project types",
    "test:parity": "vitest run --project parity",
    "test:coverage": "vitest run --coverage",
    "test:ct": "rm -rf playwright/.cache && playwright test -c playwright-ct.config.ts",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:smoke": "playwright test -c playwright.config.ts --grep @smoke",
    "e2e:live": "E2E_LIVE=1 playwright test -c playwright.config.ts start-chat-with-character.spec.ts",
    "cpd": "jscpd -c jscpd.json",
    "cpd:report": "jscpd -c jscpd.json --reporters html --output reports/cpd",
    "lens:kit-candidates": "node scripts/lens/kit-candidates.ts",
    "test:mutation": "stryker run stryker.config.json",
    "test:mutation:gate": "stryker run stryker.gate.config.json",
    "check": "node scripts/verify/run.ts --static",
    "verify": "node scripts/verify/run.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@biomejs/biome": "catalog:",
    "@orb/client": "workspace:*",
    "@orb/contracts": "workspace:*",
    "@orb/db": "workspace:*",
    "@orb/kit": "workspace:*",
    "@orb/server": "workspace:*",
    "@orb/ui": "workspace:*",
    "@playwright/experimental-ct-react": "catalog:",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
