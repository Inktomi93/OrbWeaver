{
  "name": "orbweaver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
    "dev": "bash scripts/dev/dev.sh",
    "stack": "bash scripts/dev/stack.sh",
    "design-audit": "tsx scripts/probes/design-audit.ts",
    "snap": "tsx scripts/probes/snap.ts",
    "record": "tsx scripts/probes/record.ts",
    "perf-meter": "tsx scripts/probes/perf-meter.ts",
    "motion-audit": "tsx scripts/probes/motion-audit.ts",
    "sdk:behavior-probe": "tsx scripts/probes/sdk-behavior-probe.ts",
    "sdk:cache-probe": "tsx scripts/probes/sdk-cache-probe.ts",
    "sdk:dynamic-probe": "tsx scripts/probes/sdk-dynamic-content-probe.ts",
    "sdk:injection-cache-probe": "tsx scripts/probes/sdk-injection-cache-probe.ts",
    "sdk:anth-direct-cache-probe": "tsx scripts/probes/anth-direct-cache-probe.ts",
    "sdk:session-probe": "tsx scripts/probes/sdk-session-probe.ts",
    "sse-tap": "tsx scripts/probes/sse-tap.ts",
    "trace:render": "tsx scripts/probes/trace-render.ts",
    "trace:tail": "tsx scripts/probes/trace-tail.ts",
    "trace:fire": "tsx scripts/probes/probe-fire.ts",
    "sandbox": "bash scripts/dev/sandbox.sh",
    "start": "NODE_ENV=production tsx packages/server/src/entry/index.ts",
    "engines": "bash scripts/dev/engines.sh",
    "typecheck": "pnpm -r exec tsgo --noEmit --pretty false",
    "typecheck:graph": "tsgo --noEmit --pretty false -p tsconfig.json",
    "lint": "biome check . --diagnostic-level=error --reporter=concise",
    "lint:eslint": "eslint packages/ui packages/client tests/ui tests/client packages/server packages/kit packages/db packages/contracts --max-warnings 0 --cache --cache-strategy content",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:docs": "tsx scripts/docs/format-md.ts --write",
    "check:docs": "tsx scripts/docs/format-md.ts --check",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs --output-type err-long",
    "depcruise:affected": "depcruise packages --config .dependency-cruiser.cjs --output-type err-long --affected",
    "depcruise:graph": "mkdir -p reports && depcruise packages --config .dependency-cruiser.cjs --output-type mermaid --output-to reports/dependency-graph.mmd",
    "depcruise:focus": "depcruise packages --config .dependency-cruiser.cjs --output-type mermaid --focus",
    "depcruise:reaches": "depcruise packages --config .dependency-cruiser.cjs --output-type mermaid --reaches",
    "check:structure": "tsx scripts/check/report.ts",
    "check:show": "tsx scripts/check/show.ts",
    "test": "vitest run --project unit --project integration --project integration-serial --project contract --reporter=default --reporter=json --outputFile.json=reports/test-report.json",
    "test:types": "vitest run --project types",
    "test:parity": "vitest run --project parity",
    "test:coverage": "vitest run --coverage",
    "test:ct": "rm -rf playwright/.cache && playwright test -c playwright-ct.config.ts",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:smoke": "playwright test -c playwright.config.ts --grep @smoke",
    "e2e:live": "E2E_LIVE=1 playwright test -c playwright.config.ts start-chat-with-character.spec.ts",
    "cpd": "jscpd -c jscpd.json",
    "cpd:report": "jscpd -c jscpd.json --reporters html --output reports/cpd",
    "test:mutation": "stryker run stryker.config.json",
    "test:mutation:gate": "stryker run stryker.gate.config.json",
    "check": "tsx scripts/verify/run.ts --static",
    "verify": "tsx scripts/verify/run.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@biomejs/biome": "catalog:",
    "@orb/client": "workspace:*",
    "@orb/contracts": "workspace:*",
    "@orb/db": "workspace:*",
    "@orb/kit": "workspace:*",
    "@orb/server": "workspace:*",
    "@orb/ui": "workspace:*",
    "@playwright/experimental-ct-react": "catalog:",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@total-typescript/ts-reset": "catalog:",
    "@trpc/client": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "hono": "catalog:",
    "jscpd": "catalog:",
    "lefthook": "catalog:",
    "markdownlint-cli": "^0.49.0",
    "pino-pretty": "catalog:",
    "prettier": "^3.9.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "ts-morph": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  }
}
