{
  "name": "orbweaver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "agents:sync": "node tooling/src/agent-sync/cli.ts",
    "check:agents": "node tooling/src/agent-sync/cli.ts --check",
    "agent-memory:link": "bash scripts/agent-memory-link.sh",
    "worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
    "work:item": "node tooling/src/workboard/cli.ts",
    "stack": "bash tooling/src/stack/stack.sh",
    "fixture": "bash tooling/src/stack/multi-user-fixture.sh",
    "seed:demo": "node tooling/src/seed/cli.ts demo",
    "snap": "node tooling/src/snap/cli.ts",
    "snap:devtools-assets": "node tooling/src/snap/cli.ts --materialize-devtools-assets",
    "ast": "node tooling/src/ast/cli.ts",
    "bug:reports": "node tooling/src/bug-reports/cli.ts",
    "codemod": "node tooling/src/codemod/cli.ts",
    "codemod:run": "node",
    "knip": "knip",
    "knip:prod": "knip --production --strict",
    "review:mirror": "node tooling/src/review-mirror/cli.ts",
    "sdk:behavior-probe": "node scripts/probes/sdk-behavior-probe.ts",
    "sdk:cache-probe": "node scripts/probes/sdk-cache-probe.ts",
    "sdk:dynamic-probe": "node scripts/probes/sdk-dynamic-content-probe.ts",
    "sdk:injection-cache-probe": "node scripts/probes/sdk-injection-cache-probe.ts",
    "sdk:session-probe": "node scripts/probes/sdk-session-probe.ts",
    "probe:history-system-rows": "node scripts/probes/history-system-rows.ts",
    "plugin:pack": "node scripts/pack-plugin.ts",
    "sse-tap": "node --experimental-eventsource tooling/src/wire-tap/cli.ts sse",
    "trace:render": "node tooling/src/render-trace/cli.ts render",
    "trace:tail": "node tooling/src/render-trace/cli.ts tail",
    "trace:fire": "node tooling/src/render-trace/cli.ts fire",
    "sandbox": "bash scripts/dev/sandbox.sh",
    "engines": "bash tooling/src/stack/engines.sh",
    "typecheck": "node tooling/src/verify/cli.ts typecheck",
    "prose:baseline": "node tooling/src/verify/cli.ts baseline prose",
    "check:type-ownership": "node tooling/src/verify/cli.ts tests-membership",
    "check:tests-execution-membership": "node tooling/src/verify/cli.ts tests-execution-membership",
    "check:asset-refs": "node tooling/src/verify/cli.ts asset-refs",
    "check:db-baseline": "node tooling/src/verify/cli.ts db-baseline",
    "check:drizzle-kit": "pnpm --filter @orb/db exec drizzle-kit check --config=drizzle.config.ts",
    "check:orphan-ratchet": "node tooling/src/verify/cli.ts orphan-ratchet",
    "check:boot-chunk": "node tooling/src/verify/cli.ts boot-chunk",
    "check:board-citations": "node tooling/src/verify/cli.ts board-citations",
    "check:ledgers-fresh": "node tooling/src/verify/cli.ts ledgers-fresh",
    "check:ledger-claims": "node tooling/src/verify/cli.ts ledger-claims",
    "check:biome-rule-liveness": "node tooling/src/verify/cli.ts biome-rule-liveness",
    "check:respell": "node tooling/src/ast/cli.ts respell",
    "check:swallowed": "node tooling/src/ast/cli.ts swallowed",
    "check:typeonly": "node tooling/src/ast/cli.ts typeonly-alive",
    "check:columns": "node tooling/src/ast/cli.ts columns",
    "check:regkeys": "node tooling/src/ast/cli.ts regkeys",
    "check:chains": "node tooling/src/ast/cli.ts chains",
    "lint": "nice -n 19 biome check . --diagnostic-level=error --reporter=concise",
    "lint:eslint": "node tooling/src/verify/cli.ts eslint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:docs": "node tooling/src/doc-catalog/cli.ts format --write",
    "check:docs": "node tooling/src/doc-catalog/cli.ts format --check",
    "doc-catalog:write": "node tooling/src/doc-catalog/cli.ts catalog --write",
    "doc-catalog:sync": "node tooling/src/doc-catalog/cli.ts catalog --sync",
    "doc-catalog:ratchet": "node tooling/src/doc-catalog/cli.ts catalog --ratchet",
    "check:doc-catalog": "node tooling/src/doc-catalog/cli.ts catalog --check",
    "doc-catalog:attest": "node tooling/src/doc-catalog/cli.ts attest",
    "depcruise": "node scripts/depcruise.mjs --config .dependency-cruiser.cjs --output-type err-long",
    "depcruise:affected": "depcruise packages tooling --config .dependency-cruiser.cjs --output-type err-long --affected",
    "depcruise:graph": "mkdir -p reports && depcruise packages tooling --config .dependency-cruiser.cjs --output-type mermaid --output-to reports/dependency-graph.mmd",
    "depcruise:focus": "depcruise packages tooling --config .dependency-cruiser.cjs --output-type mermaid --focus",
    "depcruise:reaches": "depcruise packages tooling --config .dependency-cruiser.cjs --output-type mermaid --reaches",
    "gate:new": "node tooling/src/verify/cli.ts new-gate",
    "gate:contract": "node tooling/src/verify/cli.ts gate-contract",
    "check:structure": "node tooling/src/verify/cli.ts structure",
    "check:structure-delta": "node tooling/src/verify/cli.ts structure-delta",
    "check:policy-conformance": "node tooling/src/verify/cli.ts policy-conformance",
    "check:show": "node tooling/src/verify/cli.ts show",
    "debt": "node tooling/src/verify/cli.ts debt",
    "test:ratchets": "node tooling/src/verify/cli.ts ratchet-gate",
    "test": "pnpm test:node && pnpm test:ct --retries=2",
    "test:node": "node scripts/vitest-supervised.mjs run --exclude 'tests/tooling/**' --runtime-only --reporter=default --reporter=json --outputFile.json=reports/test-report.json",
    "test:tooling": "node scripts/vitest-supervised.mjs run tests/tooling --runtime-only --reporter=default --reporter=json --outputFile.json=reports/test-report-tooling.json",
    "test:types": "nice -n 19 vitest run --project 'types-*'",
    "test:coverage": "nice -n 19 vitest run --coverage",
    "test:ct": "nice -n 19 node tooling/src/verify/cli.ts scoped-test ct",
    "test:scoped": "nice -n 19 node tooling/src/verify/cli.ts scoped-test node",
    "e2e": "nice -n 19 playwright test -c playwright.config.ts",
    "e2e:smoke": "nice -n 19 playwright test -c playwright.config.ts --grep @smoke",
    "e2e:live": "E2E_LIVE=1 E2E_REQUIRE_EVIDENCE=1 nice -n 19 playwright test -c playwright.config.ts start-chat-with-character.spec.ts",
    "cpd": "node scripts/cpd.ts -c jscpd.json",
    "cpd:report": "node scripts/cpd.ts -c jscpd.json --reporters html --output reports/cpd",
    "mutation:arid": "node tooling/src/mutation-arid/cli.ts",
    "mutation:probe": "node tooling/src/mutation-probe/cli.ts",
    "test:mutation": "nice -n 19 stryker run stryker.config.js",
    "test:mutation:gate": "nice -n 19 stryker run stryker.gate.config.js",
    "check": "nice -n 19 node tooling/src/verify/cli.ts run --static",
    "verify": "nice -n 19 node tooling/src/verify/cli.ts run"
  },
