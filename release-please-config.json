{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "7ff6830ca5d1aa1e905d9fcf8454e4ed87066bfc",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "New"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Faster"
    },
    {
      "type": "revert",
      "section": "Reverted"
    },
    {
      "type": "docs",
      "section": "Docs",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Refactors",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "orbweaver",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "skip-changelog": true,
      "pull-request-footer": "Merging this tags the release, publishes the GitHub release and builds the image. Next time, run `pnpm release` from main: it merges this version bump back into main before pushing.",
      "pull-request-header": "Merging this publishes the release below.",
      "exclude-paths": [".agents", ".claude", ".codex", ".github", ".vscode", "docs", "playwright", "reports", "scripts", "tests", "tooling"]
    },
    "packages": {
      "release-type": "simple",
      "component": "plugin-authoring",
      "package-name": "plugin-authoring",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "skip-changelog": true,
      "version-file": "plugin-authoring-version.txt",
      "extra-files": [
        {
          "type": "json",
          "path": "plugin-sdk/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "plugin-toolchain/package.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": [
        "packages/client",
        "packages/contracts",
        "packages/db",
        "packages/default-content",
        "packages/inference",
        "packages/kit",
        "packages/server",
        "packages/showcase-plugins",
        "packages/ui"
      ],
      "prerelease": true,
      "draft": true,
      "force-tag-creation": true
    }
  }
}
