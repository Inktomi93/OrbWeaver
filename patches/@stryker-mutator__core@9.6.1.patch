+    /**
+     * Creates a REAL directory for the sandbox's node_modules and symlinks each entry to the
+     * original — EXCEPT symlinked entries that resolve inside the project but outside any
+     * node_modules (i.e. workspace packages: pnpm/yarn/npm workspaces). Those are re-pointed at
+     * the sandbox's own copy, so the instrumented code and the tests load ONE copy of each
+     * workspace module (no module duplication / instanceof breakage / dead mutant coverage).
+     */
+    async linkNodeModulesEntries(basePath, realDir, sandboxDir) {
+        await fs.promises.mkdir(sandboxDir, { recursive: true });
+        const entries = await fs.promises.readdir(realDir, { withFileTypes: true });
+        await Promise.all(entries.map(async (entry) => {
+            const realEntry = path.join(realDir, entry.name);
+            const sandboxEntry = path.join(sandboxDir, entry.name);
+            if (entry.isSymbolicLink()) {
+                const realPath = await fs.promises.realpath(realEntry).catch(() => undefined);
+                if (realPath) {
+                    const rel = path.relative(basePath, realPath);
+                    if (!rel.startsWith('..') && !path.isAbsolute(rel) && !rel.split(path.sep).includes('node_modules')) {
+                        const sandboxTarget = path.join(this.workingDirectory, rel);
+                        const targetExists = await fs.promises.stat(sandboxTarget).then(() => true, () => false);
+                        if (targetExists) {
+                            await fileUtils.symlinkJunction(sandboxTarget, sandboxEntry).catch(() => { });
+                            return;
+                        }
+                    }
+                }
+            }
+            else if (entry.isDirectory() && entry.name.startsWith('@')) {
+                await this.linkNodeModulesEntries(basePath, realEntry, sandboxEntry);
+                return;
+            }
+            await fileUtils.symlinkJunction(realEntry, sandboxEntry).catch(() => { });
+        }));
+    }
