# Bare-metal settings for `pnpm stack …` (copy to .env — gitignored). Docker users: this file is NOT read
# by the container; use docker/orbweaver.local.env instead.
#
# The dev stack (`pnpm stack up`) needs NOTHING here: it pins single-user + dev-only secrets itself.
# The bare-metal production server (`pnpm stack start-fg prod`) reads this file, then its launcher sets
# NODE_ENV=production. Every key is optional; the full schema with defaults is
# packages/server/src/foundation/env/index.ts.
#
# NEVER put AUTH_FALLBACK in this file — it is a launch-time decision (boot-fatal here, #301). For a
# single-user production run export it on the command line: `AUTH_FALLBACK=owner pnpm stack start-fg prod`.

# single-user (default) | local | oidc | forward-header
#AUTH_MODE=single-user

# Cloud models — or paste the key in Settings → Connections instead.
#OPENROUTER_API_KEY=sk-or-…

# Local engines: off | adopt-only (you run vLLM at :8701/:8702/:8703) | adopt-or-start (the repo's fleet launcher, GPU box)
#ENGINES_POSTURE=adopt-only
#VLLM_ENGINE_HOST=127.0.0.1

# A model server on a private address (Ollama, KoboldCpp, LM Studio, …) must be allowed through the outbound firewall:
#EGRESS_ALLOWLIST=127.0.0.1,192.168.1.50
