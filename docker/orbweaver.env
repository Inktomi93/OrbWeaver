# ── Orbweaver container settings — the SHIPPED DEFAULTS ──────────────────────────────────────────────
# Read by docker-compose.yaml (env_file). This file is TRACKED: do not put keys or passwords in it. Put
# YOUR values in docker/orbweaver.local.env (gitignored; read after this file, so it overrides) — see
# docker/orbweaver.local.env.example. Every knob's full story: docker/README.md.
#
# ┌─ QUICK START ───────────────────────────────────────────────────────────────────────────────────┐
# │  1. docker compose up -d --build                                                                  │
# │  2. docker compose logs orbweaver     ← the FIRST boot prints your login (user `owner` + a password)│
# │  3. http://localhost:8788  → sign in → Settings → Connections → add your API key or model server   │
# │  Nothing below needs editing for that. Set LOCAL_INITIAL_PASSWORD in orbweaver.local.env if you   │
# │  would rather choose the password than read it from the log.                                     │
# └─────────────────────────────────────────────────────────────────────────────────────────────────┘

# ── login mode ───────────────────────────────────────────────────────────────────────────────────────
# local (default) — username + password stored by the app. Works through a published port on every
#   platform. The session cookie is Secure: http://localhost is fine (browsers treat it as secure), a LAN
#   address over plain http is NOT (the login silently fails) — put HTTPS in front for other devices.
# single-user — no login; whoever reaches the process over a LOOPBACK socket is the owner. A published
#   container port is never loopback, so this mode works only with host networking:
#   docker/compose.host-network.yaml (it sets AUTH_MODE/AUTH_FALLBACK itself). Linux/Podman.
# oidc — the app is an OIDC client (Authentik, Authelia, Keycloak, …). Block below.
# forward-header — behind a forward-auth proxy (Authentik/Authelia outpost). Block below.
AUTH_MODE=local

# What an UN-credentialed request gets: `owner` or `deny` (401). `deny` is the secure default for every
# login mode; single-user's ONLY credential is the fallback, so it needs `owner` (the host-network overlay
# sets it; the entrypoint fills it when the mode is single-user and this is unset). Never set `owner` with
# an SSO mode in production — the app refuses to boot (a same-host proxy would make everyone the owner).
AUTH_FALLBACK=deny

# ── models ───────────────────────────────────────────────────────────────────────────────────────────
# Cloud: add the key in Settings → Connections (stored encrypted), or seed OpenRouter at boot with
# OPENROUTER_API_KEY in orbweaver.local.env. Keys at rest need an encryption key; auto-generating one into
# the data volume on first boot is the turnkey default (losing the volume loses the stored keys — same
# blast radius as the database itself). Prefer CREDENTIALS_KEY / the file-secrets overlay to hold it elsewhere.
CREDENTIALS_KEY_AUTO=true

# A model server on THIS machine (Ollama, KoboldCpp, LM Studio, TabbyAPI, llama.cpp, vLLM): the container
# reaches it as http://host.docker.internal:<port>. The outbound firewall blocks private addresses by
# default (SSRF belt), so name every private host you connect to here (comma list, host only):
#EGRESS_ALLOWLIST=host.docker.internal,192.168.1.50

# Your own vLLM fleet, the way the app expects it (embed :8701 · rerank :8702 · chat :8703, the same ports
# and env as a bare-metal install): adopt it, never spawn it. Engines you do not run report down and the
# app degrades those features (search/memory need embed+rerank).
#ENGINES_POSTURE=adopt-only
#VLLM_ENGINE_HOST=host.docker.internal

# ── reaching the app from other devices ──────────────────────────────────────────────────────────────
# The port is published on 127.0.0.1 only (docker-compose.yaml). To open it: ORB_BIND=0.0.0.0 in a `.env`
# beside the compose file (or on the command line), keep AUTH_MODE=local, and put HTTPS in front (the
# cookie requires it). Bound who may knock at all with a CIDR list — behind a proxy the peer is the PROXY,
# so allowlist its address, not your laptop's:
#IP_ALLOWLIST=192.168.1.0/24

# ── diagnostics posture — OFF is the shipped posture ─────────────────────────────────────────────────
# WIRE_CAPTURE / RPG_TRACE on = a per-process ring holds the FINAL provider request bodies (system prompts,
# full transcripts, persona and world text) behind /api/_debug/*, which opens only with DEBUG_TOKEN or an
# admin session. Turning a recorder on is a two-knob edit: set IP_ALLOWLIST in the same change. The app
# logs the composed posture at boot and warns per open exposure (foundation/env/diagnostics.ts).
WIRE_CAPTURE=off
RPG_TRACE=off

# ── SSO modes (copy the block you need into orbweaver.local.env and fill it) ─────────────────────────
# oidc — all five are boot-fatal-if-missing (misconfig refuses to boot; it never degrades to owner):
#AUTH_MODE=oidc
#OIDC_ISSUER=https://auth.example.com/application/o/orbweaver/
#OIDC_CLIENT_ID=orbweaver
#OIDC_CLIENT_SECRET=…                   (or the file-secrets overlay)
#OIDC_REDIRECT_URIS=https://orbweaver.example.com/api/auth/oidc/callback
#SESSION_SECRET=…                       (≥32 chars; `openssl rand -hex 32`)
#OWNER_GROUP=orbweaver-owners           (the IdP group that elevates to owner; or OWNER_HANDLES=<one handle>)
#OIDC_ADMIN_GROUPS=orbweaver-admins
#OIDC_ALLOWED_GROUPS=orbweaver-users
#OIDC_SIGNUP=false                      (true = first-login accounts are created; default refuses unknown identities)

# forward-header — prefer the SIGNED path (JWT + JWKS); the unsigned path is fail-closed until the proxy's
# exact peer address is trusted (/32-tight — a whole subnet lets any container forge Remote-User):
#AUTH_MODE=forward-header
#FORWARD_AUTH_TRUSTED_PROXIES=172.18.0.100/32
