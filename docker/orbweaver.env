# ── Orbweaver container env — the SHIPPED SECURE DEFAULTS ────────────────────────────────────────────
# Read by docker-compose.yaml (env_file). Full mode matrix + receipts:
# docs/design/containerize-prod-image-spec.md §3; quick table: docker/README.md.
#
# SECRETS DO NOT BELONG IN THIS FILE. They ride compose file-secrets mounted at /run/secrets/* — put
# values in the files under docker/secrets/ (or point ORB_SECRETS_DIR elsewhere). An env var set HERE
# would read back out of `docker inspect`.

# ── auth mode ────────────────────────────────────────────────────────────────────────────────────────
# single-user (default): NO credential gate — every request that reaches the port IS the owner. The only
#   control is REACHABILITY, and "not published to the host" is only half of it: every OTHER container on
#   the same docker network is a reachable client. Keep single-user on a network that carries nothing but
#   your reverse proxy; on a shared/multi-tenant network (e.g. an external `inktomi-net`) or a public
#   FQDN, pick an SSO mode instead.
# local: app-stored password. REQUIRES secrets: session_secret + local_initial_password. HTTPS at the
#   browser edge is mandatory (the __Host- session cookie is Secure — plain-HTTP logins silently fail).
# oidc: the app is an OIDC client. REQUIRES secrets: session_secret + oidc_client_secret, plus the
#   OIDC_* block below. HTTPS proxy must pass X-Forwarded-Proto/Host.
# forward-header: authentik/authelia forward-auth. Prefer the SIGNED path (JWT+JWKS).
AUTH_MODE=single-user

# What an UN-credentialed request gets: `owner` or `deny` (401).
#
# THIS KNOB IS NOT INERT IN single-user. The guard is `fallback === "owner" && ownerFallbackAllowed(...)`
# (packages/server/src/infra/auth/index.ts:48) — the fallback flag is checked BEFORE the mode's
# unconditional-origin arm, so `deny` under single-user 401s EVERY request and the box serves nobody
# (behavior pinned by tests/server/infra/auth/index.test.ts:48). single-user's fallback IS its only
# credential, so it stays `owner` here.
#
# In the three SSO modes `deny` is the public-multi-user secure default: it removes the un-credentialed
# owner path entirely, so even a same-network container forging `Host: 127.0.0.1` gets 401, and the owner
# logs in via SSO (OWNER_GROUP / OWNER_HANDLES elevation) — no capability lost. Every mode block below
# therefore carries its own `AUTH_FALLBACK=deny`: change AUTH_MODE and AUTH_FALLBACK in the SAME edit.
AUTH_FALLBACK=owner

# ── debug / capture surfaces — OFF is the shipped posture ────────────────────────────────────────────
# DEBUG_TOKEN stays UNSET → the entire /api/_debug/* surface 404s. Opt in per-deploy via the
# DEBUG_TOKEN_FILE secret indirection if you must, never here.
WIRE_CAPTURE=off
RPG_TRACE=off

# ── mode-specific blocks (uncomment + fill for the mode you picked) ──────────────────────────────────
# Each block replaces the AUTH_MODE/AUTH_FALLBACK pair above — uncomment BOTH of its first two lines.

# local — app-stored password; needs the session_secret + local_initial_password secret files:
#AUTH_MODE=local
#AUTH_FALLBACK=deny

# oidc — all five are boot-fatal-if-missing in this mode (misconfig refuses to boot; it never silently
# degrades to owner-on-the-public-FQDN):
#AUTH_MODE=oidc
#AUTH_FALLBACK=deny
#OIDC_ISSUER=https://auth.example.com/application/o/orbweaver/
#OIDC_REDIRECT_URIS=https://orbweaver.example.com/api/auth/oidc/callback
#OIDC_CLIENT_ID=orbweaver
#OWNER_GROUP=orbweaver-owners
#OIDC_ADMIN_GROUPS=orbweaver-admins
#OIDC_ALLOWED_GROUPS=orbweaver-users

# forward-header — unsigned path is FAIL-CLOSED until the proxy's exact peer IP is trusted; prefer the
# signed JWT path and keep this /32-tight (a whole-subnet entry lets any container forge Remote-User):
#AUTH_MODE=forward-header
#AUTH_FALLBACK=deny
#FORWARD_AUTH_TRUSTED_PROXIES=172.18.0.100/32

# ── engines (the images bake the right posture per profile; these OVERRIDE that bake) ────────────────
# D2 remote engine WITHOUT the compose sibling (the `sibling` profile sets these on the service itself,
# which wins over this file). CAUTION — this file is read by ALL THREE profiles and an env_file value
# beats the image's ENV: uncommenting these while running `all-in-one` silently demotes that image's
# baked `adopt-or-start` to a passive consumer and its in-container fleet never spawns.
#ENGINES_POSTURE=adopt-only
#VLLM_ENGINE_HOST=my-gpu-box.internal

# ── credentials-at-rest key ──────────────────────────────────────────────────────────────────────────
# Preferred: a 32-byte key in the credentials_key secret file (losing it makes every stored BYOK
# credential undecryptable — back it up). Alternative for turnkey boots: auto-generate + persist into
# the data volume on first boot:
#CREDENTIALS_KEY_AUTO=true
