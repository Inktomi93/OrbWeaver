# Copy to docker/orbweaver.local.env (gitignored). Anything here overrides docker/orbweaver.env.
# Every line is optional — the defaults boot with zero edits and print your login on the first boot.

# Choose your password instead of reading the generated one from `docker compose logs orbweaver`:
#LOCAL_INITIAL_PASSWORD=change-me-please

# Seed an OpenRouter key at boot (or paste it in Settings → Connections instead):
#OPENROUTER_API_KEY=sk-or-…

# A model server on this machine (Ollama :11434, KoboldCpp :5001, LM Studio :1234, TabbyAPI :5000 …):
# connect to http://host.docker.internal:<port> in Settings, and allow that host through the outbound firewall:
#EGRESS_ALLOWLIST=host.docker.internal

# Your own vLLM (embed :8701 · rerank :8702 · chat :8703):
#ENGINES_POSTURE=adopt-only
#VLLM_ENGINE_HOST=host.docker.internal
