# Copy to docker/orbweaver.local.env (gitignored). Anything here overrides docker/orbweaver.env.
# Every line is optional — the defaults boot with zero edits and print how to read your login on the first boot.

# Choose your password instead of reading the generated one with `docker compose exec orbweaver cat /app/data/secrets/initial_password`:
#LOCAL_INITIAL_PASSWORD=change-me-please

# Seed an OpenRouter key at boot (or paste it in Settings → Connections instead):
#OPENROUTER_API_KEY=sk-or-…

# A model server on this machine (Ollama :11434, KoboldCpp :5001, LM Studio :1234, TabbyAPI :5000, vLLM …):
# connect to http://host.docker.internal:<port>/v1 in Settings, and admit that host as a private endpoint:
#PRIVATE_ENDPOINT_ALLOWLIST=host.docker.internal
