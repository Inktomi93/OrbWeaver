{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "root": true,
  "plugins": [],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.grit",
      "!.claude",
      "!**/routeTree.gen.ts",
      "!packages/ui/src/tokens/index.ts",
      "!packages/ui/src/styles/theme.css",
      "!**/__g_*",
      "!**/__g_*",
      "!**/node_modules/**",
      "!**/.git/**",
      "!**/dist/**",
      "!**/build/**",
      "!**/out/**",
      "!**/.stryker-tmp/**",
      "!**/reports/**",
      "!**/coverage/**",
      "!playwright/.cache/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160,
    "lineEnding": "lf",
    "bracketSpacing": true,
    "attributePosition": "auto",
    "expand": "auto"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "types": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": false
          }
        },
        "noUnusedFunctionParameters": "error",
        "noUndeclaredDependencies": "error",
        "noUnresolvedImports": "off",
        "noPrivateImports": "error",
        "noGlobalDirnameFilename": "error",
        "noProcessGlobal": "error",
        "noUnusedInstantiation": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error",
        "useJsonImportAttributes": "error",
        "useSingleJsDocAsterisk": "error",
        "useUniqueElementIds": "error",
        "noNestedComponentDefinitions": "error",
        "noReactPropAssignments": "error"
      },
      "complexity": {
        "noUselessFragments": "error",
        "noUselessUndefined": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noDivRegex": "error",
        "noRedundantDefaultExport": "error",
        "noExcessiveNestedTestSuites": "error",
        "useArrayFind": "error",
        "useWhile": "error",
        "noImplicitCoercions": {
          "level": "error",
          "options": {
            "allowDoubleNegation": true
          }
        },
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        },
        "noForEach": "error",
        "useSimplifiedLogicExpression": "error",
        "noVoid": "off",
        "useLiteralKeys": "off"
      },
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@base-ui-components/react", "@base-ui-components/react/**"],
                "message": "Dead rc-era package. Use @base-ui/react (D42)."
              },
              {
                "group": ["@dnd-kit/core", "@dnd-kit/core/**", "@dnd-kit/sortable", "@dnd-kit/sortable/**", "@dnd-kit/utilities", "@dnd-kit/utilities/**"],
                "message": "Dead legacy dnd-kit stack. Use @dnd-kit/react + @dnd-kit/helpers (ui-package-design §3, work-order item 15)."
              }
            ]
          }
        },
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useConsistentArrowReturn": "error",
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noCommonJs": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterProperties": "error",
        "noParameterAssign": "error",
        "noNestedTernary": "error",
        "noInferrableTypes": "error",
        "noExportedImports": "error",
        "noImplicitBoolean": "error",
        "noMultiAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "noSubstr": "error",
        "noProcessEnv": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useErrorCause": "error",
        "useAsConstAssertion": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentCurlyBraces": "error",
        "useConsistentMethodSignatures": "error",
        "useDefaultParameterLast": "error",
        "useExplicitLengthCheck": "error",
        "useFragmentSyntax": "error",
        "useGlobalThis": "error",
        "useNodeAssertStrict": "error",
        "useNumberNamespace": "error",
        "useObjectSpread": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useTrimStartEnd": "error",
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": {
            "allowConstantExport": true
          }
        },
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "requireAscii": true
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        },
        "noRestrictedTypes": {
          "level": "error",
          "options": {
            "types": {
              "{}": "Use `object`, `unknown`, or a concrete type.",
              "Function": "Use a specific `(...args) => ...` signature."
            }
          }
        },
        "noMagicNumbers": "error",
        "useForOf": "error",
        "useAtIndex": "error",
        "useNumericSeparators": "error",
        "useUnifiedTypeSignatures": "error",
        "useDefaultSwitchClause": "off",
        "useLiteralEnumMembers": "off",
        "useVueMultiWordComponentNames": "off"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": []
          }
        },
        "noTsIgnore": "error",
        "noEvolvingTypes": "error",
        "noImportCycles": "error",
        "noDeprecatedImports": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error",
        "noVar": "error",
        "noForIn": "error",
        "noReturnAssign": "error",
        "noUnusedExpressions": "error",
        "noUnassignedVariables": "error",
        "noEmptyBlockStatements": "error",
        "noConstantBinaryExpressions": "error",
        "noBitwiseOperators": "error",
        "noNestedPromises": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noDuplicatedSpreadProps": "error",
        "noAlert": "error",
        "noLeakedRender": "error",
        "noUnknownAttribute": "error",
        "noMisplacedAssertion": "error",
        "noReactForwardRef": "error",
        "useAwait": "error",
        "useErrorMessage": "error",
        "useArraySortCompare": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error",
        "noShadow": {
          "level": "error",
          "options": {
            "ignoreTypeValueShadow": true
          }
        },
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": false
          }
        },
        "noUnnecessaryConditions": "error",
        "noEmptySource": "off"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error",
        "noDelete": "error",
        "useTopLevelRegex": "error",
        "noAwaitInLoops": "error",
        "noNamespaceImport": "error"
      },
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noScriptUrl": "error",
        "noSecrets": "off"
      },
      "a11y": {
        "preset": "recommended",
        "noStaticElementInteractions": "error",
        "noNoninteractiveElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "useSemanticElements": "error"
      },
      "nursery": {
        "preset": "none",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "useExhaustiveSwitchCases": "error",
        "noBaseToString": "error",
        "noUnsafePlusOperands": "error",
        "noUselessTypeConversion": "error",
        "useReduceTypeParameter": "error",
        "useNullishCoalescing": "error",
        "useImportsFirst": "error",
        "noUnnecessaryTemplateExpression": "error",
        "useArraySome": "error",
        "useIncludes": "error",
        "useStringStartsEndsWith": "error",
        "useMathMinMax": "error",
        "noJsxLeakedDollar": "error",
        "noReactStringRefs": "error",
        "noComponentHookFactories": "error",
        "noJsxNamespace": "error",
        "noImpliedEval": "error",
        "noLoopFunc": "error",
        "useExpect": "error",
        "noConditionalExpect": "error",
        "noIdenticalTestTitle": "error",
        "useConsistentTestIt": "error",
        "useExplicitReturnType": "error",
        "noDrizzleDeleteWithoutWhere": "error",
        "noDrizzleUpdateWithoutWhere": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error",
        "noPlaywrightElementHandle": "error",
        "noPlaywrightEval": "error",
        "noPlaywrightForceOption": "error",
        "noPlaywrightMissingAwait": "error",
        "noPlaywrightNetworkidle": "error",
        "noPlaywrightPagePause": "error",
        "noPlaywrightUselessAwait": "error",
        "noPlaywrightWaitForNavigation": "error",
        "noPlaywrightWaitForSelector": "error",
        "noPlaywrightWaitForTimeout": "error",
        "usePlaywrightValidDescribeCallback": "error",
        "useRegexpTest": "error",
        "useRegexpExec": "error",
        "noExcessiveNestedCallbacks": "error",
        "useDisposables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 160,
      "lineEnding": "lf",
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "attributePosition": "auto"
    },
    "parser": {
      "jsxEverywhere": false
    },
    "jsxRuntime": "transparent"
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 160,
      "lineEnding": "lf",
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/db/src/schema/**",
        "packages/server/src/transport/trpc/routers/**",
        "packages/server/src/domain/chat/contract/metadata.ts",
        "packages/server/src/kit/serde/persona/index.ts"
      ],
      "plugins": []
    },
    {
      "includes": ["packages/client/src/features/app-shell/surfaces/shell.css", "packages/client/src/styles/globals.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/*/src/**/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/client/src/forms/use-app-form.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/server/src/foundation/env/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/server/src/domain/sessions/substrate/role-policy.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/codemods/codemod-kit.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/client/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": {
                "allow": ["info", "warn", "error"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/db/src/schema/**"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/server/src/domain/import/**",
        "packages/server/src/domain/export/**",
        "packages/server/src/domain/connection/**",
        "packages/server/src/domain/credentials/**",
        "packages/server/src/infra/providers/**",
        "packages/contracts/src/connection/**",
        "tests/contracts/connection/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["eslint.config.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/client/src/features/app-shell/components/section-content.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.config.ts", "**/*.config.js", "playwright*.config.ts", "tests/e2e/support/global-setup.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useNamingConvention": "off",
            "noProcessEnv": "off",
            "noMagicNumbers": "off"
          },
          "correctness": {
            "noProcessGlobal": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "useNamingConvention": "off",
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/seed/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          },
          "style": {
            "noMagicNumbers": "off",
            "useNumericSeparators": "off",
            "useShorthandAssign": "off"
          },
          "correctness": {
            "noProcessGlobal": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/client/src/lib/create-registry-context.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "noComponentHookFactories": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/client/src/state/create-drill-selection-store.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/client/src/forms/create-autosave-entity-form.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          },
          "correctness": {
            "noEmptyPattern": "off"
          },
          "nursery": {
            "useConsistentTestIt": {
              "level": "error",
              "options": {
                "function": "test",
                "withinDescribe": "test"
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
