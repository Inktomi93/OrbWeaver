{
  "extends": "./tsconfig.world-browser.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "reset.d.ts",
    "platform.d.ts",
    "packages/ui/src/markdown/css-modules.d.ts",
    "playwright/globals.d.ts",
    "tests/**/*.dom.test-d.ts",
    "tests/**/*.dom.test.ts",
    "tests/**/*.spec.ts",
    "tests/**/*.ct.tsx",
    "tests/**/*.tsx",
    "scripts/**/*.tsx",
    "tests/e2e/**/*",
    "tests/support/browser/**/*",
    "playwright/**/*",
    "scripts/probes/st-goldens/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/__g_*",
    "**/__g_*/**",
    "tests/support/iso/**/*",
    "tests/support/node/**/*",
    "scripts/probes/st-goldens/sillytavern-runtime"
  ]
}
