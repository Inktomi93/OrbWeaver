    // barrel's socket types.
    "tests/client/data/bus/chat-event-seq-guard.test.ts",
    "tests/server/transport/trpc/stream/socket.test.ts",
    // #1243: these deep-import a client feature file directly (bypassing any barrel entirely, a
    // pre-existing pattern) whose OWN code internally imports "#state" - always state/index.ts, never
    // state/pure.ts - so no pure surface can intercept it. order-home-tiles.test.ts also imports
    // HomeTileContribution from state/pure - that half stays fine, only the deep-import half forces
    // this move.
    "tests/client/features/home/lib/order-home-tiles.test.ts",
    "tests/client/features/home/lib/roadmap.test.ts",
    "tests/client/features/preset/components/prompt-assembly/marker-copy.int.test.ts",
    "tests/client/features/chat/lib/prose-settings-model.test.ts",
    "tests/client/features/chat/lib/chat-behavior-message-handling-model.test.ts",
    "tests/client/forms/autosave-convergence.suite.test.ts",
    "tests/e2e/**/*.ts"
  ]
