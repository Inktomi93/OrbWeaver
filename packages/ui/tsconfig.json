{
  // @orb/ui is browser code (the frontend cake leaf: kit ← ui ← client). DOM libs + JSX on top of
  // the isomorphic base — mirrors packages/client. ui never imports node:*; the enforcers are
  // dep-cruiser `ui-no-node-builtins` (import edges, incl. process.getBuiltinModule) and biome
  // `style/noRestrictedGlobals` (bare globals — Buffer/setImmediate/global/…, biome.json's last
  // override). tokens.build.ts (a codegen SCRIPT, not package source) is typechecked by the root
  // aggregator, not here.
  //
  // #1312 (2026-09-05): the base's `types: []` is NOT a program-level browser-purity guarantee — it
  // only suppresses AUTO-inclusion of `@types/*`, and cannot suppress the `/// <reference
  // types="node" />` a DEPENDENCY .d.ts injects (measured: vite's index.d.ts pulls @types/node into
  // THIS program, so `Buffer.from("x")` typechecks clean here). That is why the browser-global fence
  // is a lint rule, not a type-layer one.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // VITE is this package's resolver, so it stays on the bundler pair while the base went nodenext
    // (tsx-shedding stage 4). Not a weakening: node-strict resolution is a SUBSET of what vite accepts,
    // and the shared packages (kit/contracts) are checked under nodenext by their own programs.
    "module": "esnext",
    "moduleResolution": "bundler",
    // `esnext.disposable` mirrors tsconfig.base.json's lib (node-26 adoption program §1.1) — this array
    // OVERRIDES the base's, so the entry must be repeated here. (§5 rules ui/client have zero
    // disposal-shaped sites today; the lib stays uniform so a program never silently loses the typing.)
    "lib": ["es2025", "esnext.disposable", "esnext.temporal", "dom", "dom.iterable"],
    "jsx": "react-jsx"
  },
  // Also typecheck the BROWSER tests the root aggregator excludes (it's node-only — dom-BodyInit
  // would break server there): EVERY browser tsx under tests/ui, matched by DIRECTORY not filename
  // suffix — a mis-named `-fixture.tsx` outlier must never fall through to the node aggregator and be
  // checked without dom (D62 tsconfig-boundary hardening). Plus the ui-owned CT provider stack (ONLY
  // ct-providers.tsx — ct-data-providers.tsx is CLIENT-owned and typechecked by packages/client/
  // tsconfig.json; sweeping it here would drag @orb/client→@orb/server types into this program,
  // upward-cake), and the CT harness in playwright/. This is the dom program that owns @orb/ui — no
  // blind spot. (The node-side `tests/ui/tokens/*.test.ts` — a `.ts`, not `.tsx` — stays in the aggregator.)
  "include": [
    "src",
    "../../reset.d.ts",
    // The root ambient pair (node-26 adoption program §1.2) — see tsconfig.base.json's include note.
    "../../platform.d.ts",
    "../../tests/ui/**/*.tsx",
    "../../tests/support/ct/ct-providers.tsx",
    "../../tests/support/ct/contained-within-fixtures.tsx",
    "../../tests/support/ct/contained-within.ct.tsx",
    "../../tests/support/ct/touch-floor-fixtures.tsx",
    "../../tests/support/ct/touch-floor.ct.tsx",
    "../../playwright/**/*.tsx",
    "../../playwright/**/*.d.ts"
  ]
}
