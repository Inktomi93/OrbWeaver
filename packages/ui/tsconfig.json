{
  // @orb/ui is browser code (the frontend cake leaf: kit ← ui ← client). DOM libs + JSX on top of
  // the isomorphic base — mirrors packages/client. NO node types: ui never imports node:* (the
  // ui-no-node-builtins dep-cruiser rule is the backstop). tokens.build.ts (a codegen SCRIPT, not
  // package source) is typechecked by the root aggregator, not here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx"
  },
  // Also typecheck the BROWSER tests the root aggregator excludes (it's node-only — dom-BodyInit
  // would break server there): the `.ct.tsx` + `.fixtures.tsx` mirror under tests/ui, the shared
  // CT bits in tests/support/ct, and the CT harness in playwright/. This is the one program with
  // dom that owns @orb/ui, so it is the right home for its browser tests — no blind spot. (The
  // node `tests/ui/tokens/*.test.ts` stays in the aggregator; it is a `.test.ts`, not matched here.)
  "include": [
    "src",
    "../../reset.d.ts",
    "../../tests/ui/**/*.ct.tsx",
    "../../tests/ui/**/*.fixtures.tsx",
    "../../tests/support/ct/**/*.tsx",
    "../../playwright/**/*.tsx",
    "../../playwright/**/*.d.ts"
  ]
}
