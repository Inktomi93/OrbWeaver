{
  // @orb/ui is browser code (the frontend cake leaf: kit ← ui ← client). DOM libs + JSX on top of
  // the isomorphic base — mirrors packages/client. NO node types: ui never imports node:* (the
  // ui-no-node-builtins dep-cruiser rule is the backstop). tokens.build.ts (a codegen SCRIPT, not
  // package source) is typechecked by the root aggregator, not here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx"
  },
  // Also typecheck the BROWSER tests the root aggregator excludes (it's node-only — dom-BodyInit
  // would break server there): the `.ct.tsx` + `.fixtures.tsx` mirror under tests/ui, the ui-owned
  // CT provider stack (ONLY ct-providers.tsx — ct-data-providers.tsx is CLIENT-owned and typechecked
  // by packages/client/tsconfig.json; sweeping it here would drag @orb/client→@orb/server types into
  // this program, upward-cake), and the CT harness in playwright/. This is the program with dom that
  // owns @orb/ui — no blind spot. (The node `tests/ui/tokens/*.test.ts` stays in the aggregator.)
  "include": [
    "src",
    "../../reset.d.ts",
    "../../tests/ui/**/*.ct.tsx",
    "../../tests/ui/**/*.fixtures.tsx",
    "../../tests/support/ct/ct-providers.tsx",
    "../../playwright/**/*.tsx",
    "../../playwright/**/*.d.ts"
  ]
}
