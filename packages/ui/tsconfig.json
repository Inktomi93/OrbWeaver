{
  // @orb/ui is browser code (the frontend cake leaf: kit ← ui ← client). DOM libs + JSX on top of the isomorphic
  // base — mirrors packages/client. ui never imports node:*; the enforcers are dep-cruiser `ui-no-node-builtins`
  // (import edges, incl. process.getBuiltinModule) and biome `style/noRestrictedGlobals` (bare globals —
  // Buffer/setImmediate/global/…, biome.json's last override). tokens.build.ts (a codegen SCRIPT, not package
  // source) is typechecked by the root aggregator, not here.
  //
  // #1312 (2026-09-05): the base's `types: []` is NOT a program-level browser-purity guarantee — it only
  // suppresses AUTO-inclusion of `@types/*`, and cannot suppress the `/// <reference types="node" />` a
  // DEPENDENCY .d.ts injects (measured: vite's index.d.ts pulls @types/node into THIS program, so
  // `Buffer.from("x")` typechecks clean here). That is why the browser-global fence is a lint rule.
  //
  // THIS PROGRAM CHECKS ONLY ITS OWN SRC (type-worlds program, #1351): the browser tests that used to be
  // reached back into from here (`tests/ui/**/*.tsx`, the CT providers, the CT mount under playwright/) are
  // rooted by tsconfig.tests-dom.json, the browser-tests world, by directory + suffix — so this file carries
  // no `include` of its own and the base's (`src` + the root ambient pair) applies.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // VITE is this package's resolver, so it stays on the bundler pair while the base went nodenext
    // (tsx-shedding stage 4). Not a weakening: node-strict resolution is a SUBSET of what vite accepts, and
    // the shared packages (kit/contracts) are checked under nodenext by their own programs.
    "module": "esnext",
    "moduleResolution": "bundler",
    // `esnext.disposable` mirrors tsconfig.base.json's lib (node-26 adoption program §1.1) — this array
    // OVERRIDES the base's, so the entry must be repeated here.
    "lib": ["es2025", "esnext.disposable", "esnext.temporal", "dom", "dom.iterable"],
    "jsx": "react-jsx"
  }
}
