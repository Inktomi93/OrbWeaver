{
  // @orb/client is browser code (the frontend cake tip: kit ← ui ← client). DOM libs + JSX on top of the
  // isomorphic base — mirrors packages/ui. This program owns source only; browser tests belong to
  // tsconfig.tests-dom.json and the Node-side vite.config.ts belongs to the root Node program.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // VITE is this package's resolver — the bundler pair, same reasoning as packages/ui.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2025", "esnext.disposable", "esnext.temporal", "dom", "dom.iterable"],
    "jsx": "react-jsx"
  }
}
