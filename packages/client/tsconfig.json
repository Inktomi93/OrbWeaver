{
  // @orb/client is browser code (the frontend cake tip: kit ← ui ← client). DOM libs + JSX on top of the
  // isomorphic base — mirrors packages/ui. THIS PROGRAM CHECKS ONLY ITS OWN SRC + vite.config.ts (type-worlds
  // program, #1351): the browser tests it used to reach back into (`tests/client/**/*.tsx`, the client-owned CT
  // data providers) are rooted by tsconfig.tests-dom.json, the browser-tests world, by directory + suffix.
  // vite.config.ts joined 2026-08-03 so a dead vite key never sits in no program; `../../platform.d.ts` is
  // the root ambient pair's second half (node-26 adoption program §1.2) — this array overrides the base's,
  // which carries both.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // VITE is this package's resolver — the bundler pair, same reasoning as packages/ui.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2025", "esnext.disposable", "esnext.temporal", "dom", "dom.iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts", "../../reset.d.ts", "../../platform.d.ts"]
}
