{
  "name": "@orb/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.3.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./backup-names": "./src/client/backup-names.ts",
    "./query": "./src/query/index.ts",
    "./wiring": "./src/client/wiring.ts",
    "./wiring-driver": "./src/client/wiring-driver.ts",
    "./wiring-owner": "./src/client/wiring-capabilities.ts",
    "./schema": "./src/schema/index.ts"
  },
  "imports": {
    "#*": "./src/*/index.ts",
    "#src/*": "./src/*"
  },
  "dependencies": {
    "@orb/kit": "workspace:*",
    "@orb/contracts": "workspace:*",
    "@libsql/client": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  }
}
