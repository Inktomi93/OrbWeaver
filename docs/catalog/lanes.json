{
  "schemaVersion": 2,
  "lanes": [
    {
      "id": "architecture-core",
      "patterns": ["docs/architecture/core/**/*.md"]
    },
    {
      "id": "architecture-history",
      "patterns": ["docs/architecture/history/**/*.md"]
    },
    {
      "id": "architecture-proposed",
      "patterns": ["docs/architecture/proposed/**/*.md", "docs/architecture/*.md"]
    },
    {
      "id": "design",
      "patterns": ["docs/design/**/*.md"]
    },
    {
      "id": "repository-audits",
      "patterns": ["docs/history/reviews/repository-audit-*/**/*.md"]
    },
    {
      "id": "reviews",
      "patterns": ["docs/reviews/**/*.md"]
    },
    {
      "id": "root-operational",
      "patterns": ["docs/*.md"]
    },
    {
      "id": "history",
      "patterns": ["docs/history/**/*.md"],
      "excludePatterns": ["docs/history/reviews/repository-audit-*/**/*.md"]
    },
    {
      "id": "vendor",
      "patterns": ["docs/vendor/**/*.md"]
    }
  ]
}
