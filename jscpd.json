{
  "path": ["packages", "tooling/src"],
  "format": ["typescript", "tsx", "css"],
  "minTokens": 50,
  "minLines": 5,
  "maxLines": 20000,
  "maxSize": "200kb",
  "threshold": 2,
  "gitignore": true,
  "ignore": ["**/migrations/**", "**/snapshots/**", "**/__fixtures__/**", "**/*.d.ts", "tooling/src/snap/lib/devtools-frontend/**"],
  "ignorePattern": ["import.*from.*"],
  "ignoreCase": true,
  "reporters": ["console"],
  "noTips": true
}
